# 0.2 WATER VISCOSITY (IAPWS-95 + IAPWS 2008, cached per pressure)
# ==========================================
class WaterViscosity:
    """eta_water(T, P) in mPa s. Supercooled branch below 273.15 K (floor
    250.15 K). Above 372 K at low P the liquid does not exist at the
    nominal pressure, so the SATURATED-LIQUID state is used (liquid eta is
    nearly P-independent there); table extends to 623.15 K.

    CHANGE 8c NOTE: because of the saturated-liquid branch, the table built
    at the reference pressure evaluates every ambient row above 372 K at
    P = Psat(T), i.e. exactly at the resolved state pressure P_state_MPa.
    So eta(T, REFERENCE_PRESSURE_MPA) IS the viscosity at the resolved
    physical state for all ambient training rows.

    CHANGE 16 LIMITATION (final instruction truncated upstream; implemented
    as 'keep the IAPWS table'): the supercooled branch (250.15-273.15 K) is
    an EXTRAPOLATION of the IAPWS-95 EoS and IAPWS-2008 viscosity
    correlation below their certified validity range. Supercooled-water
    viscosity rises steeply and anomalously toward the homogeneous
    nucleation limit; the extrapolated values carry growing, unquantified
    uncertainty as T decreases. Walden-transformed lambdas below 273 K
    inherit that uncertainty. Documented limitation; direct cold viscosity /
    conductivity data are a priority need."""
    T_MIN, T_MAX, N_GRID = 250.15, 623.15, 200  # ~2 K spacing; cubic spline
    # interpolation error is negligible, and table builds at many pressures
    # (ratio tests) stay fast.
    def __init__(self):
        self._cache = {}
    def _key(self, P_MPa):
        return round(float(P_MPa), 4)
    def _build(self, P_MPa):
        try:
            from iapws import IAPWS95
        except ImportError:
            raise ImportError("WALDEN mode needs the iapws package: `!pip install iapws`.")
        T_grid, eta_grid = [], []
        n_sat = 0
        with warnings.catch_warnings():
            warnings.simplefilter('ignore')
            for T in np.linspace(self.T_MIN, self.T_MAX, self.N_GRID):
                try:
                    w = None
                    # saturation branch only relevant when the requested P can
                    # fall below Psat(T): Psat(623 K) ~ 16.5 MPa, so any build
                    # at P > 22 MPa is pure compressed liquid - skip the check.
                    if T > 372.0 and float(P_MPa) < 22.0:
                        sat = IAPWS95(T=float(T), x=0)
                        Psat = getattr(sat, 'P', None)
                        if Psat is not None and float(P_MPa) < Psat:
                            w = sat
                            n_sat += 1
                    if w is None:
                        w = IAPWS95(T=float(T), P=float(P_MPa))
                    mu = getattr(w, 'mu', None)
                    if mu is not None and np.isfinite(mu) and mu > 0:
                        T_grid.append(T)
                        eta_grid.append(mu * 1000.0)
                except Exception:
                    continue
        if len(T_grid) < 20:
            raise RuntimeError(f'WaterViscosity: IAPWS table build failed at P={P_MPa} MPa '
                               f'({len(T_grid)} usable points).')
        T_grid = np.asarray(T_grid)
        spl = UnivariateSpline(T_grid, np.asarray(eta_grid), k=3, s=0)
        self._cache[self._key(P_MPa)] = (spl, spl.derivative(), T_grid.min(), T_grid.max())
        sat_note = f' ({n_sat} hot points on the saturated-liquid branch)' if n_sat else ''
        print(f'  WaterViscosity: built eta(T) table at P={P_MPa} MPa, '
              f'valid {T_grid.min():.1f}-{T_grid.max():.1f} K{sat_note}.')
    def _get(self, P_MPa):
        k = self._key(P_MPa)
        if k not in self._cache:
            self._build(P_MPa)
        return self._cache[k]
    def eta(self, T_K, P_MPa):
        spl, _, lo, hi = self._get(P_MPa)
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        if np.any((T_K < lo) | (T_K > hi)):
            raise ValueError(f'WaterViscosity: T outside tabulated {lo:.1f}-{hi:.1f} K '
                             f'at P={P_MPa} MPa.')
        return spl(T_K)
    def eta_multi(self, T_K_array, P_MPa_array):
        T_K_array = np.atleast_1d(np.asarray(T_K_array, dtype=float))
        P_MPa_array = np.atleast_1d(np.asarray(P_MPa_array, dtype=float))
        if P_MPa_array.size == 1:
            P_MPa_array = np.full_like(T_K_array, P_MPa_array.item())
        out = np.empty_like(T_K_array)
        for p in np.unique(P_MPa_array):
            mask = P_MPa_array == p
            out[mask] = self.eta(T_K_array[mask], p)
        return out
    def deta_dT(self, T_K, P_MPa):
        _, dspl, lo, hi = self._get(P_MPa)
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        return dspl(np.clip(T_K, lo, hi))
    def coverage_check(self, T_K_array):
        T_K_array = np.atleast_1d(np.asarray(T_K_array, dtype=float))
        ok = T_K_array >= self.T_MIN
        n_excluded = int((~ok).sum())
        T_range_excluded = None
        if n_excluded > 0:
            excl = T_K_array[~ok]
            T_range_excluded = (float(excl.min()), float(excl.max()))
        return ok, n_excluded, T_range_excluded

VISC = WaterViscosity()

_PSAT_CACHE = {}
def psat_liquid_MPa(T_K):
    """Saturation pressure Psat(T) in MPa from IAPWS-95 (liquid side).
    Used only to RECORD the resolved state pressure P_state_MPa for ambient
    rows above PSAT_SWITCH_T_K (change 8c); viscosity for those rows is
    evaluated on the reference table's saturated-liquid branch, which is the
    same physical state."""
    from iapws import IAPWS95
    T_arr = np.atleast_1d(np.asarray(T_K, dtype=float))
    out = np.empty_like(T_arr)
    for i, T in enumerate(T_arr):
        key = round(float(T), 3)
        if key not in _PSAT_CACHE:
            with warnings.catch_warnings():
                warnings.simplefilter('ignore')
                _PSAT_CACHE[key] = float(IAPWS95(T=float(T), x=0).P)
        out[i] = _PSAT_CACHE[key]
    return out

# ==========================================
# 0.3 GROUPED CV SMOOTHING SELECTION (change 7)
# ==========================================
def _fit_sbs(t, x, z, w, kx, ky, s):
    with warnings.catch_warnings():
        warnings.simplefilter('ignore')
        return SmoothBivariateSpline(t, x, z, w=w, kx=kx, ky=ky, s=s)

def select_s_by_cv(t, x, z, w, kx, ky, label, groups=None):
    """Smoothing selection by GROUPED K-fold CV (change 7): folds are built
    from (Source, isotherm) groups, so no fold ever contains rows from a
    group that also appears in its training split. Per-ion selection (each
    surface gets its own s) is preserved by calling this per ion."""
    m = len(t)
    s_heur = m - np.sqrt(2 * m)
    if m < CV_MIN_POINTS:
        print(f"  {label}: only {m} points (< {CV_MIN_POINTS}) - skipping CV, "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    if groups is None:
        groups = np.arange(m)
        grouping_note = 'row-wise (no groups supplied)'
    else:
        groups = np.asarray(groups)
        grouping_note = '(Source, isotherm)'
    ug = np.unique(groups)
    n_groups = len(ug)
    n_folds = min(CV_FOLDS, n_groups)
    print(f"  {label}: CV grouping = {grouping_note}; {n_groups} groups -> "
          f"{n_folds} folds.")
    if n_folds < 2:
        print(f"  {label}: fewer than 2 groups - grouped CV impossible, "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    zbar = np.average(z, weights=w)
    S_var = float(np.sum((w * (z - zbar)) ** 2))
    s_grid = S_var * S_GRID_FACTORS
    rng = np.random.default_rng(CV_SEED)
    g_perm = ug[rng.permutation(n_groups)]
    g_folds = np.array_split(g_perm, n_folds)
    fold_masks = [np.isin(groups, gf) for gf in g_folds]
    n_par = (kx + 1) * (ky + 1)
    results = []
    for s in s_grid:
        sse, sw = 0.0, 0.0
        ok = True
        for fm in fold_masks:
            tr = np.flatnonzero(~fm)
            f = np.flatnonzero(fm)
            if len(tr) < n_par + 4 or len(f) == 0:
                ok = False
                break
            try:
                spl = _fit_sbs(t[tr], x[tr], z[tr], w[tr], kx, ky, s)
                pred = spl.ev(t[f], x[f])
            except Exception:
                ok = False
                break
            if not np.all(np.isfinite(pred)):
                ok = False
                break
            sse += float(np.sum(w[f] * (z[f] - pred) ** 2))
            sw += float(np.sum(w[f]))
        if ok and sw > 0:
            results.append((float(s), np.sqrt(sse / sw)))
    if not results:
        print(f"  {label}: grouped CV failed for every s candidate - "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    s_best, rmse_best = min(results, key=lambda r: r[1])
    if s_best <= s_grid[0] or s_best >= s_grid[-1]:
        print(f"  {label}: WARNING - CV optimum sits at the EDGE of the s grid "
              f"(factor {s_best / S_var:.1e}); extend S_GRID_FACTORS before trusting it.")
    z_scale = np.average(np.abs(z), weights=w)
    print(f"  {label}: grouped CV({n_folds}-fold) chose s={s_best:.4g} "
          f"(factor {s_best / S_var:.1e} of weighted variance), "
          f"CV RMSE={rmse_best:.4g} ({rmse_best / z_scale:.2%} of mean |W|), "
          f"{len(results)}/{len(s_grid)} candidates viable.")
    return s_best, results

