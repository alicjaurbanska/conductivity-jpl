    'SO4': (0.01037,  2.838,  82.37),
    'Cl':  (0.003817, 1.337,  40.99),
}

def lambda0_ion(ion, T_K):
    """Limiting single-ion molal conductivity lambda_0(T) from the
    McCleskey (2012) Table 1 quadratics (change 17)."""
    a, b, c = LAMBDA0_MC12[ion]
    T_C = np.asarray(T_K, dtype=float) - 273.15
    return a * T_C**2 + b * T_C + c

def make_anchor_rows(ion, T_lo_K, T_hi_K):
    """Synthetic training rows at I = 0 with Lambda = lambda_0(T)
    (change 17). Exact by definition of the infinite-dilution limit;
    Walden-transformed like every measured point inside IonSpline (the
    spline fits W = lambda * eta^alpha, so the anchored I = 0 edge is
    nearly flat in T and extrapolates well below the training floor).
    Clipped to the 0-95 C validity window of the Table 1 quadratics;
    an ion whose data lie entirely outside that window gets no anchors."""
    lo = max(float(T_lo_K), ANCHOR_T_WINDOW_K[0])
    hi = min(float(T_hi_K), ANCHOR_T_WINDOW_K[1])
    if hi <= lo:
        return None
    T = np.linspace(lo, hi, ANCHOR_N_T)
    return pd.DataFrame({
        'Source': ANCHOR_SOURCE, 'temp_K': T, 'I': 0.0, 'Molality': 0.0,
        'Lambda': lambda0_ion(ion, T),
        'Pressure_MPa': REFERENCE_PRESSURE_MPA,
        'P_state_MPa': REFERENCE_PRESSURE_MPA,
        'Ambient': True, 'From_Extrapolated_Known': False,
    })

