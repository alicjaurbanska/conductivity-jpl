def fit_lambda_spline(d, label, t_col='temp_K', I_col='I', lambda_col='Lambda',
                      P_col=None, s=None, anchor_ion=None):
    """Replicate policy (change 10, FINAL): rows sharing (Source, T, I[, P])
    are averaged into ONE unit-weight point; different labs stay separate
    points. No other weighting scheme.
    Determinism (change 15): canonical (Source, temp, I) sort before fitting.
    CV grouping (change 7): (Source, isotherm) with isotherm = T rounded to
    ISOTHERM_ROUND_K.
    Anchors (change 17): if anchor_ion names an ion in LAMBDA0_MC12,
    lambda_0 rows at I = 0 are appended before fitting. Skipped when the
    frame already carries ANCHOR_SOURCE rows, so the residual-filter refit
    and the ablation hook never double-add anchors. Anchor rows assume the
    default column names (temp_K, I, Lambda)."""
    d = d.copy()
    if ANCHOR_LAMBDA0 and anchor_ion in LAMBDA0_MC12 and \
            not (d['Source'] == ANCHOR_SOURCE).any():
        anc = make_anchor_rows(anchor_ion, d[t_col].min(), d[t_col].max())
        if anc is not None:
            anc = anc.reindex(columns=d.columns)  # align; absent cols -> NaN
            d = pd.concat([d, anc], ignore_index=True)
            print(f"  {label}: appended {len(anc)} lambda_0 anchor rows at I=0 "
                  f"(Source='{ANCHOR_SOURCE}', T "
                  f"{anc['temp_K'].min():.1f}-{anc['temp_K'].max():.1f} K).")
        else:
            print(f"  {label}: no lambda_0 anchors - data T range lies outside "
                  f"the {ANCHOR_T_WINDOW_K[0]:.1f}-{ANCHOR_T_WINDOW_K[1]:.1f} K "
                  f"validity window.")
    d = d.sort_values(['Source', t_col, I_col] if 'Source' in d.columns
                      else [t_col, I_col], kind='mergesort').reset_index(drop=True)
    if 'Ambient' in d.columns and not bool(np.all(d['Ambient'].values)):
        raise RuntimeError(f'{label}: non-ambient row(s) reached spline fitting - '
                           f'ambient policy violated (change 8).')
    n_before = len(d)
    group_cols = (['Source'] if 'Source' in d.columns else []) + \
        ([t_col, I_col] if P_col is None else [t_col, I_col, P_col])
    other_cols = [c for c in d.columns if c not in group_cols + [lambda_col]]
    grouped = d.groupby(group_cols, as_index=False).agg(
        **{lambda_col: (lambda_col, 'mean')},
        _n_reps=(lambda_col, 'size'),
        _lambda_std=(lambda_col, 'std'),
    )
    if other_cols:
        agg_map = {c: ('max' if c == 'From_Extrapolated_Known' else 'first')
                   for c in other_cols}
        firsts = d.groupby(group_cols, as_index=False).agg(agg_map)
        grouped = grouped.merge(firsts, on=group_cols)
    d = grouped
    n_collapsed = int((d['_n_reps'] > 1).sum())
    if n_collapsed > 0:
        max_reps = int(d['_n_reps'].max())
        rel_spread = (d.loc[d['_n_reps'] > 1, '_lambda_std'] /
                      d.loc[d['_n_reps'] > 1, lambda_col].abs())
        worst_spread = float(rel_spread.max()) if len(rel_spread) else 0.0
        print(f"  {label}: collapsed {n_before} rows -> {len(d)} unique "
              f"(Source, T, I{', P' if P_col else ''}) points "
              f"({n_collapsed} conditions averaged over up to {max_reps} within-author "
              f"replicates, worst relative std = {worst_spread:.2%}; all points weight 1).")
    d = d.drop(columns=['_n_reps', '_lambda_std'])
    d = d.sort_values(['Source', t_col, I_col] if 'Source' in d.columns
                      else [t_col, I_col], kind='mergesort').reset_index(drop=True)
    if len(d) < MIN_POINTS:
        raise ValueError(f"{label} has too few points ({len(d)}).")
    iso = np.round(d[t_col].values / ISOTHERM_ROUND_K).astype(int)
    if 'Source' in d.columns:
        groups = np.array([f"{s_}|T{i_}" for s_, i_ in zip(d['Source'].values, iso)])
    else:
        groups = np.array([f"T{i_}" for i_ in iso])
    P_arg = d[P_col].values if P_col else None
    spline = IonSpline(d[t_col].values, d[I_col].values, d[lambda_col].values, label,
                       s=s, P_MPa=P_arg, groups=groups)
    fitted = spline.ev(d[t_col].values, d[I_col].values,
                       P_MPa=P_arg if P_col else None)
    rel_rmse = np.sqrt(np.mean((d[lambda_col].values - fitted) ** 2)) / d[lambda_col].mean()
    print(f"{label}: built on {len(d)} points [{spline.method}], "
          f"training rel. RMSE={rel_rmse:.3e}, "
          f"T {spline.t_range[0]:.1f}-{spline.t_range[1]:.1f} K, "
          f"I {spline.I_range[0]:.4f}-{spline.I_range[1]:.4f} mol/kg")
    return spline, spline.t_range, spline.I_range, d

def _residual_outlier_refit(spline, t_range, I_range, dfit, label):
    """Change 11: residual-based outlier filter replacing the global 8-MAD
    filter. Uses the provisional spline's RELATIVE residuals; points above
    OUTLIER_REL_RESID_MAX are excluded WITH a printed report, then the
    surface is refit ONCE. Boundary points are flagged, never silently
    deleted. Change 17: lambda_0 anchor rows are exact by definition and
    are NEVER outlier-filtered; a note is printed if they exceed the
    threshold (that indicates a low-I misfit, not bad anchors)."""
    fitted = np.atleast_1d(spline.ev(dfit['temp_K'].values, dfit['I'].values))
    rel = (dfit['Lambda'].values - fitted) / dfit['Lambda'].values
    bad = np.abs(rel) > OUTLIER_REL_RESID_MAX
    is_anchor = dfit['Source'].values == ANCHOR_SOURCE
    n_anchor_flagged = int((bad & is_anchor).sum())
    if n_anchor_flagged:
        print(f"  {label}: NOTE - {n_anchor_flagged} lambda_0 anchor row(s) "
              f"exceed the residual threshold but are EXEMPT from exclusion "
              f"(change 17); inspect the low-I fit if this persists.")
    bad &= ~is_anchor
    if not bad.any():
        print(f"  {label}: residual outlier filter (|rel resid| > "
              f"{OUTLIER_REL_RESID_MAX:.0%}): no exclusions.")
        return spline, t_range, I_range, dfit
    t_lo, t_hi = dfit['temp_K'].min(), dfit['temp_K'].max()
    I_lo, I_hi = dfit['I'].min(), dfit['I'].max()
    print(f"  {label}: residual outlier filter (|rel resid| > "
          f"{OUTLIER_REL_RESID_MAX:.0%}) excludes {int(bad.sum())} point(s):")
    for i in np.flatnonzero(bad):
        on_edge = (np.isclose(dfit['temp_K'].iloc[i], t_lo) or
                   np.isclose(dfit['temp_K'].iloc[i], t_hi) or
                   np.isclose(dfit['I'].iloc[i], I_lo) or
                   np.isclose(dfit['I'].iloc[i], I_hi))
        print(f"    T={dfit['temp_K'].iloc[i]:.1f} K, I={dfit['I'].iloc[i]:.4f}, "
              f"Source={dfit['Source'].iloc[i]}, rel resid={rel[i]:+.1%}"
              + ("  [BOUNDARY point - inspect before trusting exclusion]"
                 if on_edge else ""))
    dfit2 = dfit[~bad].copy()
    spline2, tr2, ir2, dfit2 = fit_lambda_spline(
        dfit2, label + ' [refit after residual filter]')
    return spline2, tr2, ir2, dfit2

def subtract_ion_molar(source_df, salt_name, known_ion, model,
                       new_ion_pretty_label=None, known_ion_extrap_mode=None):
    """Deconvolution step with:
      change 5: From_Extrapolated_Known tagging of rows whose known-ion
                lambda came from cold-side extrapolation;
      change 6: subtraction-fraction guard f = m_free_known*lambda_known /
                kappa_salt (exclude f > SUBTRACTION_FRACTION_MAX) and free-
                molality guard (exclude m_free_new < MIN_FREE_MOLALITY_MOLKG),
                with per-salt f distribution;
      change 11: residual-based outlier filter;
      change 12: cause analysis for non-positive derived lambdas;
      change 17: the derived-ion surface is fitted WITH lambda_0 anchor rows
                (anchor_ion=new_ion passed to fit_lambda_spline)."""
    stoich = model.stoich_for(salt_name)
    if known_ion not in stoich:
        raise ValueError(f"{salt_name} stoichiometry {stoich} has no ion '{known_ion}'.")
    unknown_ions = [ion for ion in stoich if ion != known_ion]
    if len(unknown_ions) != 1:
        raise ValueError(f"subtract_ion_molar needs a two-ion salt; {salt_name}: {stoich}.")
    new_ion = unknown_ions[0]
    new_ion_label = new_ion_pretty_label or f"{new_ion} (from {salt_name})"
    ion_spline = model.ion(known_ion)
    src = source_df
    I_vals = src['I'].values
    t_vals = src['temp_K'].values
    m_salt = src['Molality'].values
    src_vals = src['Source'].values
    m_free_known = src[ION_FREE_COL[known_ion]].values
    m_free_new_all = src[ION_FREE_COL[new_ion]].values
    # Training-state viscosity: reference table (saturated branch above 372 K
    # = the resolved P_state; change 8c).
    lambda_known = ion_spline.ev_or_nan(t_vals, I_vals)
    from_extrap = np.zeros(len(src), dtype=bool)
    if known_ion_extrap_mode is not None:
        need_extrap = np.isnan(lambda_known)
        if need_extrap.any():
            extrap_vals = ion_spline.ev_extrap(t_vals[need_extrap], I_vals[need_extrap],
                                               mode=known_ion_extrap_mode)
            lambda_known = lambda_known.copy()
            lambda_known[need_extrap] = extrap_vals
            fin = np.isfinite(extrap_vals)
            idx_need = np.flatnonzero(need_extrap)
            from_extrap[idx_need[fin]] = True
            n_extrap_used = int(fin.sum())
            extrap_range = (f"{extrap_vals[fin].min():.3g} to {extrap_vals[fin].max():.3g}"
                            if n_extrap_used else "n/a")
            print(f"  {salt_name} -> {new_ion_label}: {n_extrap_used}/{int(need_extrap.sum())} "
                  f"below-hull points recovered via {known_ion}.ev_extrap"
                  f"('{known_ion_extrap_mode}'), lambda range: {extrap_range}. "
                  f"Rows tagged From_Extrapolated_Known=True.")
    in_hull = np.isfinite(lambda_known)
    n_out = int((~in_hull).sum())
    if n_out > 0:
        print(f"NOTE: {salt_name} -> {new_ion_label}: {n_out}/{len(src)} points outside "
              f"the {known_ion} spline's coverage at solution I. Excluded.")
    T = t_vals[in_hull]
    I = I_vals[in_hull]
    M = m_salt[in_hull]
    S = src_vals[in_hull]
    mk = m_free_known[in_hull]
    mn = m_free_new_all[in_hull]
    lk = lambda_known[in_hull]
    fx = from_extrap[in_hull]
    P_rec = src['Pressure_MPa'].values[in_hull]
    P_state = src['P_state_MPa'].values[in_hull]
    kappa_salt = src['Conductivity'].values[in_hull]
    kappa_pairs = np.zeros_like(kappa_salt)
    if PAIR_CONDUCTION and salt_name in SALT_PAIR_TERMS:
        cols = [c for c in SALT_PAIR_TERMS[salt_name] if c in src.columns]
        if cols:
            kappa_pairs = pair_conduction_mc12(src[in_hull], T, I, cols)
            frac_pairs = kappa_pairs / kappa_salt
            print(f"  {salt_name}: subtracting {', '.join(cols)} conduction "
                  f"via the shared MC12 submodel (up to "
                  f"{100 * frac_pairs.max():.1f}% of kappa).")
    # ---- change 6: subtraction guards --------------------------------
    f = (mk * lk) / kappa_salt
    print(f"  {salt_name}: subtraction fraction f distribution: min={f.min():.3f}, "
          f"median={np.median(f):.3f}, max={f.max():.3f} (n={len(f)}).")
    excl_f = f > SUBTRACTION_FRACTION_MAX
    excl_m = mn < MIN_FREE_MOLALITY_MOLKG
    excl_any = excl_f | excl_m
    if excl_any.any():
        print(f"  {salt_name} -> {new_ion_label}: excluding {int(excl_any.sum())} "
              f"row(s) by subtraction guards:")
        for i in np.flatnonzero(excl_any):
            reasons = []
            if excl_f[i]:
                reasons.append(f"f={f[i]:.3f} > {SUBTRACTION_FRACTION_MAX}")
            if excl_m[i]:
                reasons.append(f"m_free_new={mn[i]:.3g} < {MIN_FREE_MOLALITY_MOLKG:g}")
            print(f"    (T={T[i]:.1f} K, I={I[i]:.4f}, {S[i]}): " + '; '.join(reasons))
    keep = ~excl_any
    lambda_new = (kappa_salt - kappa_pairs - mk * lk) / np.where(mn > 0, mn, np.nan)
    kept_idx = np.flatnonzero(keep)
    lam_k = lambda_new[kept_idx]
    # ---- change 12: non-positive drop with cause analysis ------------
    posmask = lam_k > 0
    if (~posmask).any():
        drop_idx = kept_idx[~posmask]
        print(f"WARNING: {len(drop_idx)} {new_ion_label} derived point(s) "
              f"non-positive - dropped. Cause analysis (change 12):")
        for i in drop_idx:
            print(f"    T={T[i]:.1f} K, I={I[i]:.4f}, Source={S[i]}, "
                  f"f={f[i]:.3f}, m_free_new={mn[i]:.3g}, lambda={lambda_new[i]:.3g}")
        T_d, I_d = T[drop_idx], I[drop_idx]
        t_span = max(T.max() - T.min(), 1e-9)
        i_span = max(I.max() - I.min(), 1e-9)
        t_frac = (T_d.max() - T_d.min()) / t_span
        i_frac = (I_d.max() - I_d.min()) / i_span
        if len(drop_idx) >= 2 and t_frac < 0.25 and i_frac < 0.25:
            print(f"    -> dropped points CLUSTER in T "
                  f"[{T_d.min():.1f}, {T_d.max():.1f}] K, I "
                  f"[{I_d.min():.4f}, {I_d.max():.4f}] "
                  f"({t_frac:.0%} of T span, {i_frac:.0%} of I span): likely a "
                  f"COVERAGE GAP in that (T, I) region, not noise.")
        else:
            print(f"    -> dropped points are scattered across (T, I) "
                  f"({t_frac:.0%} of T span, {i_frac:.0%} of I span): "
                  f"consistent with noise.")
    final_idx = kept_idx[posmask]
    ion_df = pd.DataFrame({'Source': S[final_idx], 'temp_K': T[final_idx],
                           'I': I[final_idx], 'Molality': M[final_idx],
                           'Lambda': lambda_new[final_idx],
                           'Pressure_MPa': P_rec[final_idx],
                           'P_state_MPa': P_state[final_idx],
                           'Ambient': True,
                           'From_Extrapolated_Known': fx[final_idx]})
    spline, t_range, I_range, dfit = fit_lambda_spline(ion_df, new_ion_label,
                                                       anchor_ion=new_ion)
    spline, t_range, I_range, dfit = _residual_outlier_refit(
        spline, t_range, I_range, dfit, new_ion_label)
    n_tag = int(dfit['From_Extrapolated_Known'].sum())
    print(f"  {new_ion_label}: {n_tag}/{len(dfit)} fitted points carry "
          f"From_Extrapolated_Known=True (known-ion lambda extrapolated).")
    model.add_ion(new_ion, spline)
    return spline, t_range, I_range, dfit

