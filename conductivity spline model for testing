def _clean_speciated_rows(d, tag, require_ambient):
    """Rename/derive working columns and apply the EXPLICIT AMBIENT POLICY
    (change 8):
      (a) every McCleskey2011 row is ambient BY DEFINITION (measurements
          above 100 C are saturated-liquid states, ambient-equivalent);
      (b) other sources are ambient iff |P - 0.1| <= AMBIENT_P_TOL_MPA;
      (c) ambient rows above PSAT_SWITCH_T_K get P_state_MPa = Psat(T)
          (saturated liquid), else 0.1; the Walden eta for those rows is
          evaluated on the reference table's saturated-liquid branch, i.e.
          at exactly this resolved state.
    require_ambient=True (all FIT salts and validation stashes) drops
    non-ambient rows so none can reach any fit; TEST-ONLY pools keep their
    pressure rows (tagged Ambient=False) for staged evaluation (change 9).
    change 19: the working coordinate column 'I' is taken from I_COORD
    ('I_eff' speciated, or 'I_formal' stoichiometric)."""
    d = d.copy()
    if d.empty:
        raise ValueError(f"No rows found for {tag}. Check CSV.")
    d = d[~d['Molality_molkg'].isna()].copy()
    if d.empty:
        raise ValueError(f'{tag} has no usable rows left.')
    if d['I_eff'].isna().any():
        raise RuntimeError(f'{tag}: unspeciated rows survived the merge assertion - bug.')
    d = d.rename(columns={'Molality_molkg': 'Molality', 'Temperature_C': 'Temperature',
                          'Conductivity_mScm': 'Conductivity'})
    d['temp_K'] = d['Temperature'] + 273.15
    d['I'] = d[I_COORD]
    d['Ambient'] = (d['Source'] == 'McCleskey2011') | \
        ((d['Pressure_MPa'] - REFERENCE_PRESSURE_MPA).abs() <= AMBIENT_P_TOL_MPA)
    if require_ambient:
        n_bad = int((~d['Ambient']).sum())
        if n_bad:
            _bad = d[~d['Ambient']]
            print(f"  Ambient policy [{tag}]: excluding {n_bad}/{len(d)} non-ambient "
                  f"row(s) (P {_bad['Pressure_MPa'].min():.2f}-"
                  f"{_bad['Pressure_MPa'].max():.2f} MPa) from all fitting.")
            d = d[d['Ambient']].copy()
        if d.empty:
            raise ValueError(f'{tag} has no ambient rows.')
    d['P_state_MPa'] = np.where(d['Ambient'], REFERENCE_PRESSURE_MPA,
                                d['Pressure_MPa'])
    hot = d['Ambient'].values & (d['temp_K'].values > PSAT_SWITCH_T_K)
    if hot.any():
        d.loc[hot, 'P_state_MPa'] = psat_liquid_MPa(d.loc[hot, 'temp_K'].values)
        print(f"  Ambient policy [{tag}]: {int(hot.sum())} ambient row(s) above "
              f"{PSAT_SWITCH_T_K:.0f} K -> P_state_MPa = Psat(T) "
              f"({d.loc[hot, 'P_state_MPa'].min():.3f}-"
              f"{d.loc[hot, 'P_state_MPa'].max():.3f} MPa; saturated liquid). "
              f"Viscosity for these rows is the reference table's "
              f"saturated-liquid branch = eta at that resolved state.")
    # change 15: canonical sort before any downstream use.
    d = d.sort_values(['Source', 'temp_K', 'I'], kind='mergesort').reset_index(drop=True)
    return d

def _iapws_filter(d, tag):
