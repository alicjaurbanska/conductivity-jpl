PAIR_CONDUCTION = True
MC12_PAIR_COEFFS = {
    # (lam0 quadratic a,b,c), (A quadratic p,q,r), B  -- McCleskey (2012) Table 1
    'KSO4':  ((-0.002439, 4.253, 129.7), (-0.01576, 6.210, 146.8), 1.3),
    'NaSO4': ((0.002309, 5.459, 219.2), (0.01454, 5.193, 253.6), 0.5),
}
PAIR_LAMBDA_FOR_COL = {'m_pair_KSO4': 'KSO4', 'm_pair_NaSO4': 'NaSO4'}
SALT_PAIR_TERMS = {'K2SO4': ['m_pair_KSO4'], 'Na2SO4': ['m_pair_NaSO4']}

def mc12_pair_lambda(pair_key, T_K, I):
    """Molar conductivity of a conducting ion pair (KSO4-, NaSO4-) from the
    McCleskey (2012) Table 1 coefficients. Part of the shared MC12 submodel;
    see pair_conduction_mc12 for the full provenance statement."""
    (a, b, c), (p, q, r), B = MC12_PAIR_COEFFS[pair_key]
    T_C = np.asarray(T_K, dtype=float) - 273.15
    sqrt_I = np.sqrt(np.asarray(I, dtype=float))
    lam0 = a * T_C**2 + b * T_C + c
    A = p * T_C**2 + q * T_C + r
    return lam0 - A * sqrt_I / (1.0 + B * sqrt_I)

def pair_conduction_mc12(source_df_or_cols, T_K, I, pair_cols):
    """SHARED McCLESKEY-2012 ION-PAIR SUBMODEL (used in training AND
    prediction). This inclusion is a deliberate, final design choice.

    (a) The KSO4- and NaSO4- lambda coefficients come from McCleskey (2012)
        Table 1.
    (b) Because the same coefficients also live inside the McCleskey baseline
        used for model comparison, the empirical model PARTLY SHARES A
        SUBMODEL with that baseline. This shared dependency is accepted and
        documented as a limitation of the comparison. (change 17 note: the
        lambda_0 anchor functions in LAMBDA0_MC12 come from the same table,
        so the same limitation statement covers them.)
    (c) The coefficients were originally regressed with WATEQ4F speciation;
        this model feeds them SUPCRT free-ion / pair molalities, so the
        pairing convention is not identical to the original regression.
        (change 19 note: in the I_formal variant they also receive formal
        rather than speciated I - a further, documented convention shift.)
    (d) The pair lambdas are NOT Walden-transformed: they carry no pressure
        response (ambient-only expressions in T and sqrt(I)).
    Returns the pair contribution to kappa (mS/cm)."""
    total = np.zeros_like(np.atleast_1d(np.asarray(T_K, dtype=float)))
    for col in pair_cols:
        key = PAIR_LAMBDA_FOR_COL[col]
        m_pair = np.asarray(source_df_or_cols[col], dtype=float)
        total = total + np.nan_to_num(m_pair) * mc12_pair_lambda(key, T_K, I)
    return total

