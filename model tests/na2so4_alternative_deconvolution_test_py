I_hi = min(spline_so4_seq.I_range[1], spline_so4_alt.I_range[1])
if T_hi <= T_lo or I_hi <= I_lo:
    raise RuntimeError("SO4 surfaces have no overlapping (T, I) range.")
print(f"\nOverlap window: T {T_lo:.1f}-{T_hi:.1f} K, "
      f"I_eff {I_lo:.4f}-{I_hi:.4f} mol/kg")

Tg, Ig = np.meshgrid(np.linspace(T_lo, T_hi, 80),
                     np.geomspace(I_lo, I_hi, 80))
Tf, If = Tg.ravel(), Ig.ravel()
lam_seq = spline_so4_seq.ev_or_nan(Tf, If)
lam_alt = spline_so4_alt.ev_or_nan(Tf, If)
both = np.isfinite(lam_seq) & np.isfinite(lam_alt)
pct_diff = np.full_like(lam_seq, np.nan)
pct_diff[both] = 100.0 * (lam_alt[both] - lam_seq[both]) / lam_seq[both]

print(f"\nSO4 lambda comparison on hull intersection "
      f"({int(both.sum())}/{len(Tf)} grid points inside both hulls):")
print(f"  mean signed diff (ALT - production): {np.nanmean(pct_diff):+.2f}%")
print(f"  mean abs diff:  {np.nanmean(np.abs(pct_diff)):.2f}%")
print(f"  max abs diff:   {np.nanmax(np.abs(pct_diff)):.2f}%")
r_I = sstats.pearsonr(If[both], pct_diff[both])
r_T = sstats.pearsonr(Tf[both], pct_diff[both])
print(f"  diff vs I_eff: r={r_I[0]:+.3f} (p={r_I[1]:.4f})   "
      f"diff vs T: r={r_T[0]:+.3f} (p={r_T[1]:.4f})")
print("  Interpretation guide: an I-correlated difference is the expected "
      "signature of the salt-specific viscosity stowaway on the I axis "
      "(K2SO4 vs Na2SO4 solution viscosities diverge with concentration); "
      "a flat multiplicative offset would instead point at the KSO4-/NaSO4- "
      "pair-lambda or transport-number channels.")

