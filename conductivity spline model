def plot_ion_spline(spline, t_range, I_range, ion_df, title, ax, n_points=60):
    # plotted in the fit coordinates (T, sqrt I_eff) so the near-linear
    # Kohlrausch edge shows as near-linear
    x_lo, x_hi = np.sqrt(I_range[0]), np.sqrt(I_range[1])
    Tg, Xg = np.meshgrid(np.linspace(t_range[0], t_range[1], n_points),
                         np.linspace(x_lo, x_hi, n_points))
    Z = spline.ev_or_nan(Tg.ravel(), Xg.ravel() ** 2).reshape(Tg.shape)
    surf = ax.plot_surface(Tg, Xg, Z, cmap='viridis', linewidth=0,
                           antialiased=True, alpha=0.9)
    ax.scatter(ion_df['temp_K'], np.sqrt(ion_df['I']), ion_df['Lambda'],
               color='black', s=6, depthshade=False)
    ax.set_title(title, pad=0)
    ax.set_xlabel('T (K)', labelpad=2)
    ax.set_ylabel(r'$\sqrt{I_{\mathrm{eff}}}$ ((mol kg$^{-1}$)$^{1/2}$)', labelpad=2)
    ax.set_zlabel(r'$\lambda_i$ (mS cm$^{-1}$ (mol kg$^{-1}$)$^{-1}$)', labelpad=2)
    ax.tick_params(pad=0, labelsize=8)
    return surf

# ==========================================
# WATER VISCOSITY, AMBIENT (IAPWS-95 + IAPWS 2008)
# ==========================================
class WaterViscosity:
    """eta(T) of liquid water at ambient pressure, in mPa s, tabulated once
    from the iapws package and interpolated with a cubic spline.

    Above ~372 K liquid water does not exist at 0.1 MPa, so the table
    switches to the saturated-liquid state there; liquid viscosity is nearly
    pressure-independent along that branch, so this is the appropriate state
    for the high-temperature ambient measurements. Below 273.15 K (floor
    250.15 K) the table extrapolates the IAPWS formulations into the
    supercooled region, outside their certified validity; supercooled
    viscosity rises steeply and anomalously, so Walden-transformed lambdas
    below 0 C inherit a growing, unquantified uncertainty. Direct cold
    viscosity and conductivity data would remove this."""
    T_MIN, T_MAX, N_GRID = 250.15, 623.15, 200  # ~2 K spacing; spline
                                                # interpolation error negligible
    def __init__(self):
        self._table = None
    def _build(self):
        try:
            from iapws import IAPWS95
        except ImportError:
            raise ImportError("Walden transform needs the iapws package: `!pip install iapws`.")
        T_grid, eta_grid = [], []
        n_sat = 0
        with warnings.catch_warnings():
            warnings.simplefilter('ignore')
            for T in np.linspace(self.T_MIN, self.T_MAX, self.N_GRID):
                try:
                    w = None
                    if T > 372.0:
                        sat = IAPWS95(T=float(T), x=0)
                        Psat = getattr(sat, 'P', None)
                        if Psat is not None and REFERENCE_PRESSURE_MPA < Psat:
                            w = sat
                            n_sat += 1
                    if w is None:
                        w = IAPWS95(T=float(T), P=REFERENCE_PRESSURE_MPA)
                    mu = getattr(w, 'mu', None)
                    if mu is not None and np.isfinite(mu) and mu > 0:
                        T_grid.append(T)
                        eta_grid.append(mu * 1000.0)
                except Exception:
                    continue
        if len(T_grid) < 20:
            raise RuntimeError(f'WaterViscosity: IAPWS table build failed '
                               f'({len(T_grid)} usable points).')
        T_grid = np.asarray(T_grid)
        spl = UnivariateSpline(T_grid, np.asarray(eta_grid), k=3, s=0)
        self._table = (spl, spl.derivative(), T_grid.min(), T_grid.max())
        sat_note = f' ({n_sat} points on the saturated-liquid branch)' if n_sat else ''
        print(f'  WaterViscosity: built eta(T) table at ambient pressure, '
              f'valid {T_grid.min():.1f}-{T_grid.max():.1f} K{sat_note}.')
    def _get(self):
        if self._table is None:
            self._build()
        return self._table
    def eta(self, T_K):
        spl, _, lo, hi = self._get()
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        if np.any((T_K < lo) | (T_K > hi)):
            raise ValueError(f'WaterViscosity: T outside tabulated {lo:.1f}-{hi:.1f} K.')
        return spl(T_K)
    def deta_dT(self, T_K):
        _, dspl, lo, hi = self._get()
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        return dspl(np.clip(T_K, lo, hi))
    def coverage_check(self, T_K_array):
        T_K_array = np.atleast_1d(np.asarray(T_K_array, dtype=float))
        ok = T_K_array >= self.T_MIN
        n_excluded = int((~ok).sum())
        T_range_excluded = None
        if n_excluded > 0:
            excl = T_K_array[~ok]
            T_range_excluded = (float(excl.min()), float(excl.max()))
        return ok, n_excluded, T_range_excluded

VISC = WaterViscosity()

# ==========================================
# SMOOTHING SELECTION BY GROUPED CV
# ==========================================
def _fit_sbs(t, x, z, w, kx, ky, s):
    with warnings.catch_warnings():
        warnings.simplefilter('ignore')
        return SmoothBivariateSpline(t, x, z, w=w, kx=kx, ky=ky, s=s)

def select_s_by_cv(t, x, z, w, kx, ky, label, groups=None):
    """Pick the spline smoothing parameter s by grouped K-fold CV. Folds are
    built from (Source, isotherm) groups, so a validation fold never shares a
    lab-isotherm with its training split. Called per ion, so each surface
    gets its own s. Falls back to the FITPACK heuristic s = m - sqrt(2m)
    when the data are too few or too poorly grouped for CV."""
    m = len(t)
    s_heur = m - np.sqrt(2 * m)
    if m < CV_MIN_POINTS:
        print(f"  {label}: only {m} points (< {CV_MIN_POINTS}) - skipping CV, "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    if groups is None:
        groups = np.arange(m)
        grouping_note = 'row-wise (no groups supplied)'
    else:
        groups = np.asarray(groups)
        grouping_note = '(Source, isotherm)'
    ug = np.unique(groups)
    n_groups = len(ug)
    n_folds = min(CV_FOLDS, n_groups)
    print(f"  {label}: CV grouping = {grouping_note}; {n_groups} groups -> "
          f"{n_folds} folds.")
    if n_folds < 2:
        print(f"  {label}: fewer than 2 groups - grouped CV impossible, "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    zbar = np.average(z, weights=w)
    S_var = float(np.sum((w * (z - zbar)) ** 2))
    s_grid = S_var * S_GRID_FACTORS
    rng = np.random.default_rng(CV_SEED)
    g_perm = ug[rng.permutation(n_groups)]
    g_folds = np.array_split(g_perm, n_folds)
    fold_masks = [np.isin(groups, gf) for gf in g_folds]
    n_par = (kx + 1) * (ky + 1)
    results = []
    for s in s_grid:
        sse, sw = 0.0, 0.0
        ok = True
        for fm in fold_masks:
            tr = np.flatnonzero(~fm)
            f = np.flatnonzero(fm)
            if len(tr) < n_par + 4 or len(f) == 0:
                ok = False
                break
            try:
                spl = _fit_sbs(t[tr], x[tr], z[tr], w[tr], kx, ky, s)
                pred = spl.ev(t[f], x[f])
            except Exception:
                ok = False
                break
            if not np.all(np.isfinite(pred)):
                ok = False
                break
            sse += float(np.sum(w[f] * (z[f] - pred) ** 2))
            sw += float(np.sum(w[f]))
        if ok and sw > 0:
            results.append((float(s), np.sqrt(sse / sw)))
    if not results:
        print(f"  {label}: grouped CV failed for every s candidate - "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    s_best, rmse_best = min(results, key=lambda r: r[1])
    if s_best <= s_grid[0] or s_best >= s_grid[-1]:
        print(f"  {label}: warning - CV optimum sits at the edge of the s grid "
              f"(factor {s_best / S_var:.1e}); extend S_GRID_FACTORS before trusting it.")
    z_scale = np.average(np.abs(z), weights=w)
    print(f"  {label}: grouped CV({n_folds}-fold) chose s={s_best:.4g} "
          f"(factor {s_best / S_var:.1e} of weighted variance), "
          f"CV RMSE={rmse_best:.4g} ({rmse_best / z_scale:.2%} of mean |W|), "
          f"{len(results)}/{len(s_grid)} candidates viable.")
    return s_best, results

# ==========================================
# ION SURFACE
# ==========================================
class IonSpline:
    """Bicubic spline surface for one ion over (T, sqrt(I_eff)).

    The spline is fitted to the Walden product W_i = lambda_i * eta(T)^alpha_i
    rather than to lambda_i itself: W is nearly flat in T, which the spline
    captures more easily and which makes cold-side extrapolation safer. The
    exponent alpha_i is fitted per ion (clipped to [0.5, 1.2]) and every
    evaluator converts back with lambda_i = W_i / eta(T)^alpha_i. Queries
    outside the convex hull of the training points return NaN."""
    def __init__(self, t, I, lambda_val, label, s=None, w=None, kx=3, ky=3,
                 groups=None):
        self.label = label
        t = np.asarray(t, dtype=float)
        I = np.asarray(I, dtype=float)
        lambda_val = np.asarray(lambda_val, dtype=float)
        w = np.ones_like(t) if w is None else np.asarray(w, dtype=float) / np.mean(w)
        self.alpha = self._fit_alpha(t, I, lambda_val)
        z_fit = lambda_val * VISC.eta(t) ** self.alpha
        n_t, n_I = len(np.unique(t)), len(np.unique(I))
        if n_t < kx + 1 or n_I < ky + 1:
            raise ValueError(
                f"{label}: a bidegree-{kx} spline needs >= {kx + 1} distinct T values "
                f"and >= {ky + 1} distinct I values; got {n_t} T levels, {n_I} I levels.")
        x = self._x(I)
        if s is None:
            s_used, self.cv_table = select_s_by_cv(t, x, z_fit, w, kx, ky, label,
                                                   groups=groups)
        else:
            s_used, self.cv_table = s, None
        last_err = None
        for _ in range(6):
            try:
                self._spline = _fit_sbs(t, x, z_fit, w, kx, ky, s_used)
                break
            except Exception as e:
                last_err = e
                s_used *= 2.0
                print(f"  {label}: fit failed at s={s_used / 2:.4g} ({e}); retrying s={s_used:.4g}.")
        else:
            raise RuntimeError(f"{label}: spline fit failed even after relaxing s: {last_err}")
        self.s_used = s_used
        self.method = (f'scattered grouped-CV (SmoothBivariateSpline, s={s_used:.3g}) '
                       f'[Walden a={self.alpha:.3f}]')
        self._hull = Delaunay(np.column_stack([t, x]))
        self.t_range = (float(t.min()), float(t.max()))
        self.I_range = (float(I.min()), float(I.max()))
        self.validate_physics()

    @staticmethod
    def _fit_alpha(t, I, lam):
        # regress log(lambda) on [1, sqrt I, I, log eta]; alpha is minus the
        # log-eta coefficient
        eta = VISC.eta(t)
        s = np.sqrt(np.asarray(I, dtype=float))
        A = np.column_stack([np.ones_like(s), s, s * s, np.log(eta)])
        coef, *_ = np.linalg.lstsq(A, np.log(np.asarray(lam, dtype=float)), rcond=None)
        return float(np.clip(-coef[3], 0.5, 1.2))
    def _in_hull(self, t_query, I_query):
        return self._hull.find_simplex(np.column_stack([t_query, self._x(I_query)])) >= 0
    @staticmethod
    def _x(I):
        return np.sqrt(I)
    def W(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        z = self._spline.ev(t_query, self._x(I_query))
        return np.where(self._in_hull(t_query, I_query), z, np.nan)
    def ev_or_nan(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        z = self._spline.ev(t_query, self._x(I_query))
        z = z / VISC.eta(t_query) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), z, np.nan)
    def ev(self, t_query, I_query):
        result = self.ev_or_nan(t_query, I_query)
        if np.any(np.isnan(result)):
            raise ValueError(f"{self.label} spline: query point(s) outside the convex hull.")
        return result if result.size > 1 else result.item()

    def ev_extrap(self, t_query, I_query, mode='linear', T_max_K=30.0):
        """Cold-side extension: linear (tangent) or constant continuation of W
        in T below the training floor, at most T_max_K kelvin down. Only used
        where no sub-zero data exist; measured cold KCl conductivity would
        replace it for the K+/Cl- reference surfaces and shorten the
        extrapolated segment of every ion derived from them."""
        T = np.atleast_1d(np.asarray(t_query, dtype=float))
        I = np.atleast_1d(np.asarray(I_query, dtype=float))
        x = self._x(I)
        T_edge = np.full_like(T, self.t_range[0])
        ok = self._hull.find_simplex(np.column_stack([T_edge + 1e-6, x])) >= 0
        ok &= (T >= self.t_range[0] - T_max_K)
        ok &= (T <= self.t_range[0] + 1e-9)
        W = self._spline.ev(T_edge, x)
        if mode == 'linear':
            W = W + self._spline.ev(T_edge, x, dx=1) * (T - T_edge)
        elif mode != 'constant':
            raise ValueError(f"ev_extrap mode must be 'constant' or 'linear', got {mode}")
        lam = W / VISC.eta(T) ** self.alpha
        return np.where(ok, lam, np.nan)

    def dT(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        dW = self._spline.ev(t_query, self._x(I_query), dx=1, dy=0)
        eta = VISC.eta(t_query)
        eta_a = eta ** self.alpha
        lam = self._spline.ev(t_query, self._x(I_query)) / eta_a
        val = dW / eta_a - self.alpha * lam * VISC.deta_dT(t_query) / eta
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def dI_val(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        g = self._spline.ev(t_query, self._x(I_query), dx=0, dy=1)
        val = g / (2 * np.sqrt(I_query))
        val = val / VISC.eta(t_query) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def d2I_val(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        g1 = self._spline.ev(t_query, self._x(I_query), dx=0, dy=1)
        g2 = self._spline.ev(t_query, self._x(I_query), dx=0, dy=2)
        u = np.sqrt(I_query)
        val = g2 / (4 * I_query) - g1 / (4 * I_query * u)
        val = val / VISC.eta(t_query) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def validate_physics(self):
        """Scan the surface inside the hull for sign violations: lambda < 0,
        d lambda/dT < 0, d lambda/dI > 0, d2 lambda/dI2 < 0. Prints warnings
        only; the fit is not modified. The scan floor in I is 1e-3 because at
        the anchored I = 0 edge d lambda/dI diverges as 1/sqrt(I) by the
        Kohlrausch limiting law (the slope in sqrt(I) stays finite) - that
        divergence is expected, not a fit defect."""
        t_vals = np.linspace(self.t_range[0], self.t_range[1], 50)
        I_lo = max(1e-3, self.I_range[0])
        I_vals = np.geomspace(I_lo, self.I_range[1], 50)
        Tg, Ig = np.meshgrid(t_vals, I_vals)
        Tg_flat, Ig_flat = Tg.ravel(), Ig.ravel()
        inside = self._in_hull(Tg_flat, Ig_flat)
        Ti, Ii = Tg_flat[inside], Ig_flat[inside]
        if len(Ti) == 0:
            return
        lam = self.ev_or_nan(Ti, Ii)
        dT = self.dT(Ti, Ii)
        dI = self.dI_val(Ti, Ii)
        d2I = self.d2I_val(Ti, Ii)
        def _report(name, values, mask, worst_fn):
            n = int(mask.sum())
            if n == 0:
                return None
            worst = worst_fn(values[mask])
            scale = np.median(np.abs(values[np.isfinite(values)]))
            frac = abs(worst) / scale if scale > 0 else float('nan')
            return (f"{n} points have {name} (worst={worst:.4g}, "
                    f"typical scale={scale:.4g}, worst/typical={frac:.1%})")
        violations = [v for v in [
            _report('lam < 0', lam, lam < 0, np.min),
            _report('dT < 0', dT, dT < 0, np.min),
            _report('dI > 0', dI, dI > 0, np.max),
            _report('d2I < 0', d2I, d2I < 0, np.min),
        ] if v is not None]
        if violations:
            print(f"  [physics warning for {self.label}]: violations inside hull:")
            for v in violations:
                print(f"    - {v}")

# ==========================================
# SPECIATION LOOKUP
# ==========================================
# Speciation (free-ion and pair molalities, effective ionic strength) is
# precomputed with Reaktoro and read from CSV tables; nothing is speciated at
# run time. Tables that carry several pressure planes are reduced to their
# first plane, consistent with the ambient-only scope.
ION_FREE_COL = {'K': 'm_free_K', 'Cl': 'm_free_Cl', 'Na': 'm_free_Na',
                'Mg': 'm_free_Mg', 'SO4': 'm_free_SO4',
                'NH4': 'm_free_NH4', 'Ca': 'm_free_Ca'}
PAIR_COLS = ['m_pair_KSO4', 'm_pair_NaSO4', 'm_pair_MgSO4']
MERGE_DECIMALS = 6

class SpeciationLookup:
    """Per-salt interpolation of the speciation tables over (T, molality).
    Salts with a full 2D grid get a linear 2D interpolator; degenerate grids
    (a single molality level or a single isotherm) fall back to 1D
    interpolation along the varying axis, and a single-condition table to an
    exact-match lookup."""

    def __init__(self, spec_df):
        self.interp2d = {}
        self.P_plane = {}
        all_cols = list(ION_FREE_COL.values()) + PAIR_COLS + ['I_eff']
        m_tol = 10.0 ** (-MERGE_DECIMALS)

        def _f_2d(pts, vals):
            f = LinearNDInterpolator(pts, vals)
            return lambda Tq, mq: f(np.atleast_1d(Tq), np.atleast_1d(mq))

        def _f_1d_T(T_pts, vals, m0):
            order = np.argsort(T_pts)
            Ts, vs = T_pts[order], vals[order]
            def f(Tq, mq):
                Tq = np.atleast_1d(np.asarray(Tq, dtype=float))
                mq = np.atleast_1d(np.asarray(mq, dtype=float))
                out = np.interp(Tq, Ts, vs, left=np.nan, right=np.nan)
                on_level = np.abs(mq - m0) <= max(m_tol, 1e-9 * abs(m0))
                return np.where(on_level, out, np.nan)
            return f

        def _f_1d_m(m_pts, vals, T0):
            order = np.argsort(m_pts)
            ms, vs = m_pts[order], vals[order]
            def f(Tq, mq):
                Tq = np.atleast_1d(np.asarray(Tq, dtype=float))
                mq = np.atleast_1d(np.asarray(mq, dtype=float))
                out = np.interp(mq, ms, vs, left=np.nan, right=np.nan)
                on_level = np.abs(Tq - T0) <= 1e-6
                return np.where(on_level, out, np.nan)
            return f

        def _f_0d(v0, T0, m0):
            def f(Tq, mq):
                Tq = np.atleast_1d(np.asarray(Tq, dtype=float))
                mq = np.atleast_1d(np.asarray(mq, dtype=float))
                hit = (np.abs(Tq - T0) <= 1e-6) & \
                      (np.abs(mq - m0) <= max(m_tol, 1e-9 * abs(m0)))
                return np.where(hit, v0, np.nan)
            return f

        for salt, d in spec_df.groupby('Salt'):
            P_lv = np.sort(d['Pressure_MPa'].round(MERGE_DECIMALS).unique())
            self.P_plane[salt] = float(P_lv[0])
            if len(P_lv) > 1:
                print(f"SpeciationLookup: {salt} table has {len(P_lv)} pressure "
                      f"planes; only the P={P_lv[0]} MPa plane is used "
                      f"(ambient-only model).")
            cols_present = [c for c in all_cols if c in d.columns]
            d0 = d[d['Pressure_MPa'].round(MERGE_DECIMALS) == P_lv[0]]
            T = d0['Temperature_C'].values + 273.15
            M = d0['Molality_molkg'].values
            n_T = len(np.unique(np.round(T, 6)))
            n_M = len(np.unique(np.round(M, MERGE_DECIMALS)))
            if n_T >= 2 and n_M >= 2:
                pts0 = np.column_stack([T, M])
                self.interp2d[salt] = {c: _f_2d(pts0, d0[c].values)
                                       for c in cols_present}
            elif n_M == 1 and n_T >= 2:
                m0 = float(M[0])
                print(f"SpeciationLookup: {salt} has a single molality level "
                      f"(m={m0:g} mol/kg, {n_T} temperatures) - 1D interpolation "
                      f"in T at that fixed m.")
                self.interp2d[salt] = {c: _f_1d_T(T, d0[c].values, m0)
                                       for c in cols_present}
            elif n_T == 1 and n_M >= 2:
                T0 = float(T[0])
                print(f"SpeciationLookup: {salt} has a single isotherm "
                      f"(T={T0 - 273.15:g} C, {n_M} molalities) - 1D interpolation "
                      f"in m at that fixed T.")
                self.interp2d[salt] = {c: _f_1d_m(M, d0[c].values, T0)
                                       for c in cols_present}
            else:
                T0, m0 = float(T[0]), float(M[0])
                print(f"SpeciationLookup: {salt} has a single condition "
                      f"(T={T0 - 273.15:g} C, m={m0:g}) - exact-match lookup only.")
                self.interp2d[salt] = {c: _f_0d(float(d0[c].values[0]), T0, m0)
                                       for c in cols_present}

    def get(self, salt, T_K, molality, col):
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        molality = np.atleast_1d(np.asarray(molality, dtype=float))
        f2 = self.interp2d[salt].get(col)
        if f2 is None:
            return np.full(T_K.shape, np.nan)
        return f2(T_K, molality)

# ==========================================
# CONDUCTIVITY MODEL
# ==========================================
class IonConductivityModel:
    """Holds the fitted ion surfaces and reconstructs solution conductivity
    as kappa = sum_i m_free_i * lambda_i(T, I_eff) plus the charged-pair
    contribution (McCleskey 2012 expressions). Neutral MgSO4(aq) contributes
    zero. Molalities in mol/kg; kappa in mS/cm."""
    SALT_STOICHIOMETRY = {
        'KCl':    {'K': 1, 'Cl': 1},
        'NaCl':   {'Na': 1, 'Cl': 1},
        'MgCl2':  {'Mg': 1, 'Cl': 2},
        'Na2SO4': {'Na': 2, 'SO4': 1},
        'K2SO4':  {'K': 2, 'SO4': 1},
        'MgSO4':  {'Mg': 1, 'SO4': 1},
        'CaSO4':  {'Ca': 1, 'SO4': 1},
        'NH4Cl':  {'NH4': 1, 'Cl': 1},
        'CaCl2':  {'Ca': 1, 'Cl': 2},
    }
    CONDUCTING_PAIRS = set(MC12_PAIR_COEFFS)   # KSO4, NaSO4
    NEUTRAL_PAIRS = {'MgSO4'}                  # accepted, contributes zero

    def __init__(self, speciation=None):
        self.splines = {}
        self.speciation = speciation
    def add_ion(self, ion_name, spline):
        self.splines[ion_name] = spline
        return spline
    def ion(self, ion_name):
        if ion_name not in self.splines:
            raise KeyError(f"No fitted spline for ion '{ion_name}' yet. "
                           f"Available: {list(self.splines)}")
        return self.splines[ion_name]
    def stoich_for(self, salt_name):
        if salt_name not in self.SALT_STOICHIOMETRY:
            raise ValueError(f"Unknown salt '{salt_name}'. Known: {list(self.SALT_STOICHIOMETRY)}")
        return self.SALT_STOICHIOMETRY[salt_name]

    def predict_conductivity(self, speciated_composition, temperature_K,
                             output_unit="mS/cm", extrap_mode=None,
                             return_diagnostics=False):
        """Predict kappa for an arbitrary speciated composition (no salt
        names needed, so mixtures work).

        speciated_composition:
          { "I_eff": float or array,
            "free_molality": {"Na":..., "Cl":..., "K":..., "Mg":..., "Ca":...,
                              "SO4":..., "NH4":...},          # mol/kg
            "pair_molality": {"KSO4":..., "NaSO4":..., "MgSO4":...},
            "speciation_source": str, "sample_id": str }

        A charged species above PREDICT_MIN_SPECIES_MOLALITY with no fitted
        surface raises. Out-of-hull queries return NaN unless extrap_mode
        ('linear' or 'constant') enables the cold-side extension.
        return_diagnostics=True also returns per-species contributions and
        coverage flags."""
        comp = speciated_composition
        T = np.atleast_1d(np.asarray(temperature_K, dtype=float))
        I_in = np.atleast_1d(np.asarray(comp['I_eff'], dtype=float))
        shape = np.broadcast_shapes(T.shape, I_in.shape)
        T = np.broadcast_to(T, shape).astype(float)
        I = np.broadcast_to(I_in, shape).astype(float)
        total = np.zeros(shape, dtype=float)
        diag = {'sample_id': comp.get('sample_id'),
                'speciation_source': comp.get('speciation_source'),
                'per_ion_kappa': {}, 'per_pair_kappa': {},
                'flags': {'out_of_hull': {}, 'extrapolated': {},
                          'no_coverage': None, 'neutral_pairs': []}}
        # free charged species
        for sp, m_val in (comp.get('free_molality', {}) or {}).items():
            m = np.broadcast_to(np.asarray(m_val, dtype=float), shape).astype(float)
            m = np.nan_to_num(m)
            if not np.any(m > PREDICT_MIN_SPECIES_MOLALITY):
                continue
            if sp not in self.splines:
                raise KeyError(
                    f"predict_conductivity: charged species '{sp}' present at "
                    f"m > {PREDICT_MIN_SPECIES_MOLALITY:g} mol/kg but no ion "
                    f"surface is fitted for it. Fitted ions: {sorted(self.splines)}.")
            spl = self.splines[sp]
            lam = spl.ev_or_nan(T, I)
            oob = ~np.isfinite(lam)
            used_ext = np.zeros(shape, dtype=bool)
            if extrap_mode is not None and oob.any():
                lam_ext = spl.ev_extrap(T[oob], I[oob], mode=extrap_mode)
                lam = lam.copy()
                lam[oob] = lam_ext
                used_ext[oob] = np.isfinite(lam_ext)
            contrib = m * lam
            total = total + contrib
            diag['per_ion_kappa'][sp] = contrib
            diag['flags']['out_of_hull'][sp] = oob & ~used_ext & (m > PREDICT_MIN_SPECIES_MOLALITY)
            diag['flags']['extrapolated'][sp] = used_ext
        # ion pairs
        for pk, m_val in (comp.get('pair_molality', {}) or {}).items():
            m = np.broadcast_to(np.asarray(m_val, dtype=float), shape).astype(float)
            m = np.nan_to_num(m)
            if pk in self.CONDUCTING_PAIRS:
                if PAIR_CONDUCTION and np.any(m > 0):
                    contrib = m * mc12_pair_lambda(pk, T, I)
                    total = total + contrib
                    diag['per_pair_kappa'][pk] = contrib
            elif pk in self.NEUTRAL_PAIRS:
                diag['flags']['neutral_pairs'].append(pk)
            else:
                raise KeyError(
                    f"predict_conductivity: unknown pair species '{pk}'. Conducting "
                    f"pairs: {sorted(self.CONDUCTING_PAIRS)}; neutral pairs: "
                    f"{sorted(self.NEUTRAL_PAIRS)}.")
        no_cov = ~np.isfinite(I)
        total = np.where(no_cov, np.nan, total)
        diag['flags']['no_coverage'] = no_cov
        if output_unit == 'mS/cm':
            pass
        elif output_unit == 'S/m':
            total = total * 0.1
        else:
            raise ValueError(f"output_unit must be 'mS/cm' or 'S/m', got '{output_unit}'.")
        out = total if total.size > 1 else total.item()
        return (out, diag) if return_diagnostics else out

    def predict_from_speciation(self, salt_key, T_K, molality, extrap_mode=None):
        """Convenience wrapper for a single salt: pulls the speciated
        composition from the SpeciationLookup and calls predict_conductivity."""
        if self.speciation is None:
            raise RuntimeError('predict_from_speciation() requires a SpeciationLookup.')
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        molality = np.atleast_1d(np.asarray(molality, dtype=float))
        I = self.speciation.get(salt_key, T_K, molality, 'I_eff')
        free = {ion: np.nan_to_num(self.speciation.get(salt_key, T_K, molality, col))
                for ion, col in ION_FREE_COL.items()}
        pairs = {}
        for col, key in PAIR_LAMBDA_FOR_COL.items():
            pairs[key] = np.nan_to_num(self.speciation.get(salt_key, T_K, molality, col))
        pairs['MgSO4'] = np.nan_to_num(self.speciation.get(salt_key, T_K, molality,
                                                           'm_pair_MgSO4'))
        comp = {'I_eff': I, 'free_molality': free, 'pair_molality': pairs,
                'speciation_source': SPECIATION_DB, 'sample_id': str(salt_key)}
        return self.predict_conductivity(comp, T_K, extrap_mode=extrap_mode)

    def predict(self, salt_name, T_K, molality, allow_extrapolation_nan=True):
        """Older stoichiometry-keyed prediction, kept for compatibility."""
        stoich = self.stoich_for(salt_name)
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        molality = np.atleast_1d(np.asarray(molality, dtype=float))
        if self.speciation is None:
            raise RuntimeError("predict() requires a SpeciationLookup.")
        I = self.speciation.get(salt_name, T_K, molality, 'I_eff')
        total = np.zeros_like(T_K, dtype=float)
        for ion_name in stoich:
            spline = self.ion(ion_name)
            m_free = self.speciation.get(salt_name, T_K, molality,
                                         ION_FREE_COL[ion_name])
            eval_fn = spline.ev_or_nan if allow_extrapolation_nan else spline.ev
            lam = eval_fn(T_K, I)
            total = total + m_free * lam
        if PAIR_CONDUCTION and salt_name in SALT_PAIR_TERMS:
            cols = {}
            for col in SALT_PAIR_TERMS[salt_name]:
                cols[col] = self.speciation.get(salt_name, T_K, molality, col)
            total = total + pair_conduction_mc12(cols, T_K, I, list(cols))
        return total if total.size > 1 else total.item()

