    for src, salts in VALIDATION_SALTS_BY_SOURCE.items():
        if salt not in salts or salt not in FIT_SALTS:
            continue
        d_val_raw = d_salt[d_salt['Source'] == src]
        if d_val_raw.empty:
            continue
        d_val = _clean_speciated_rows(d_val_raw, f"{salt}/{src} (validation)",
                                      restrict_pressure=AMBIENT_ONLY)
        d_val = _iapws_filter(d_val, f"{salt}/{src} (validation)")
        cross_lab_validation_dfs[(salt, src)] = d_val
        print(f"  -> cross-lab validation stash: {salt}/{src}: {len(d_val)} rows")

# ==========================================
# 2. TRANSPORT NUMBER FUNCTION (ambient correlation; KCl split + joint anchors)
# ==========================================
def calculate_t_kcl(temp_C, molality):
    term1 = (9.04e-7 * (temp_C ** 2)) - (0.000235 * temp_C) + 0.4960
    sqrt_m = np.sqrt(molality)
    term2 = 0.0027 * (sqrt_m / (1.0 + 0.05 * sqrt_m))
    return term1 - term2

# ==========================================
# 3. HELPERS (sequential chain)
# ==========================================
def fit_lambda_spline(d, label, t_col='temp_K', I_col='I', lambda_col='Lambda',
                      P_col=None, s=None):
    """Replicate policy: rows sharing (Source, T, I[, P]) are averaged into
    ONE unit-weight point; different labs stay separate points."""
    d = d.copy()
    n_before = len(d)
    group_cols = (['Source'] if 'Source' in d.columns else []) + \
        ([t_col, I_col] if P_col is None else [t_col, I_col, P_col])
    other_cols = [c for c in d.columns if c not in group_cols + [lambda_col]]
    grouped = d.groupby(group_cols, as_index=False).agg(
        **{lambda_col: (lambda_col, 'mean')},
        _n_reps=(lambda_col, 'size'),
        _lambda_std=(lambda_col, 'std'),
    )
    if other_cols:
        firsts = d.groupby(group_cols, as_index=False)[other_cols].first()
        grouped = grouped.merge(firsts, on=group_cols)
    d = grouped
    n_collapsed = int((d['_n_reps'] > 1).sum())
    if n_collapsed > 0:
        max_reps = int(d['_n_reps'].max())
        rel_spread = (d.loc[d['_n_reps'] > 1, '_lambda_std'] /
                      d.loc[d['_n_reps'] > 1, lambda_col].abs())
        worst_spread = float(rel_spread.max()) if len(rel_spread) else 0.0
        print(f"  {label}: collapsed {n_before} rows -> {len(d)} unique "
              f"(Source, T, I{', P' if P_col else ''}) points "
              f"({n_collapsed} conditions averaged over up to {max_reps} within-author "
              f"replicates, worst relative std = {worst_spread:.2%}; all points weight 1).")
    d = d.drop(columns=['_n_reps', '_lambda_std'])
    if len(d) < MIN_POINTS:
        raise ValueError(f"{label} has too few points ({len(d)}).")
    P_arg = d[P_col].values if P_col else None
    spline = IonSpline(d[t_col].values, d[I_col].values, d[lambda_col].values, label,
                       s=s, P_MPa=P_arg)
    fitted = spline.ev(d[t_col].values, d[I_col].values,
                       P_MPa=P_arg if P_col else None)
    rel_rmse = np.sqrt(np.mean((d[lambda_col].values - fitted) ** 2)) / d[lambda_col].mean()
    print(f"{label}: built on {len(d)} points [{spline.method}], "
          f"training rel. RMSE={rel_rmse:.3e}, "
          f"T {spline.t_range[0]:.1f}-{spline.t_range[1]:.1f} K, "
          f"I {spline.I_range[0]:.4f}-{spline.I_range[1]:.4f} mol/kg")
    return spline, spline.t_range, spline.I_range, d

def subtract_ion_molar(source_df, salt_name, known_ion, model, new_ion_pretty_label=None,
                       known_ion_extrap_mode=None, P_col=None):
    stoich = model.stoich_for(salt_name)
    if known_ion not in stoich:
        raise ValueError(f"{salt_name} stoichiometry {stoich} has no ion '{known_ion}'.")
    unknown_ions = [ion for ion in stoich if ion != known_ion]
    if len(unknown_ions) != 1:
        raise ValueError(f"subtract_ion_molar needs a two-ion salt; {salt_name}: {stoich}.")
    new_ion = unknown_ions[0]
    new_ion_label = new_ion_pretty_label or f"{new_ion} (from {salt_name})"
    ion_spline = model.ion(known_ion)
    I_vals = source_df['I'].values
    t_vals = source_df['temp_K'].values
    m_salt = source_df['Molality'].values
    src_vals = source_df['Source'].values
    m_free_known = source_df[ION_FREE_COL[known_ion]].values
    m_free_new = source_df[ION_FREE_COL[new_ion]].values
    P_vals = source_df[P_col].values if P_col else np.full(len(source_df), REFERENCE_PRESSURE_MPA)
    lambda_known = ion_spline.ev_or_nan(t_vals, I_vals, P_MPa=P_vals if P_col else None)
    if known_ion_extrap_mode is not None:
        need_extrap = np.isnan(lambda_known)
        if need_extrap.any():
            extrap_vals = ion_spline.ev_extrap(t_vals[need_extrap], I_vals[need_extrap],
                                               mode=known_ion_extrap_mode,
                                               P_MPa=P_vals[need_extrap] if P_col else None)
            lambda_known = lambda_known.copy()
            lambda_known[need_extrap] = extrap_vals
            finite_extrap = extrap_vals[np.isfinite(extrap_vals)]
            n_extrap_used = int(finite_extrap.size)
            extrap_range = (f"{finite_extrap.min():.3g} to {finite_extrap.max():.3g}"
                            if n_extrap_used else "n/a")
            print(f"  {salt_name} -> {new_ion_label}: {n_extrap_used}/{need_extrap.sum()} "
                  f"below-hull points recovered via {known_ion}.ev_extrap"
                  f"('{known_ion_extrap_mode}'), lambda range: {extrap_range}.")
    in_hull = ~np.isnan(lambda_known)
    n_out = (~in_hull).sum()
    if n_out > 0:
        print(f"NOTE: {salt_name} -> {new_ion_label}: {n_out}/{len(source_df)} points outside "
              f"the {known_ion} spline's coverage at solution I. Excluded.")
    kappa_salt = source_df['Conductivity'].values[in_hull]
    kappa_pairs = np.zeros_like(kappa_salt)
    if PAIR_CONDUCTION and salt_name in SALT_PAIR_TERMS:
        cols = [c for c in SALT_PAIR_TERMS[salt_name] if c in source_df.columns]
        if cols:
            kappa_pairs = pair_kappa(source_df.iloc[in_hull], t_vals[in_hull],
                                     I_vals[in_hull], cols)
            frac = kappa_pairs / kappa_salt
            print(f"  {salt_name}: subtracting {', '.join(cols)} conduction "
                  f"(up to {100 * frac.max():.1f}% of kappa).")
    kappa_residual = kappa_salt - kappa_pairs - (m_free_known[in_hull] * lambda_known[in_hull])
    lambda_new = kappa_residual / m_free_new[in_hull]
    t_kept, I_kept = t_vals[in_hull], I_vals[in_hull]
    m_kept, P_kept = m_salt[in_hull], P_vals[in_hull]
    src_kept = src_vals[in_hull]
    pos = lambda_new > 0
    if (~pos).any():
        print(f"WARNING: {(~pos).sum()} {new_ion_label} points non-positive. Dropped.")
    candidate = lambda_new[pos]
    if candidate.size >= 8:
        med = np.median(candidate)
        mad = np.median(np.abs(candidate - med))
        robust_scale = 1.4826 * mad if mad > 0 else np.std(candidate)
        MAD_MULTIPLIER = 8.0
        not_outlier = (np.abs(candidate - med) <= MAD_MULTIPLIER * robust_scale
                       if robust_scale > 0 else np.ones_like(candidate, dtype=bool))
        n_outlier = int((~not_outlier).sum())
        if n_outlier > 0:
            print(f"WARNING: {n_outlier} {new_ion_label} points >{MAD_MULTIPLIER:.0f} MADs "
                  f"from median ({med:.4g}) - dropped (range: "
                  f"{candidate[~not_outlier].min():.4g} to {candidate[~not_outlier].max():.4g}).")
        pos_idx = np.flatnonzero(pos)
        keep_idx = pos_idx[not_outlier]
        pos = np.zeros_like(pos)
        pos[keep_idx] = True
    ion_df = pd.DataFrame({'Source': src_kept[pos], 'temp_K': t_kept[pos],
                           'I': I_kept[pos], 'Molality': m_kept[pos],
                           'Lambda': lambda_new[pos], 'Pressure_MPa': P_kept[pos]})
    spline, t_range, I_range, ion_df = fit_lambda_spline(
        ion_df, new_ion_label, P_col='Pressure_MPa' if P_col else None)
    model.add_ion(new_ion, spline)
    return spline, t_range, I_range, ion_df

