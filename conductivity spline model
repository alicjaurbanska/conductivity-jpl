model_seq = model
SEQ_SPLINES = {'K': spline_k, 'Cl': spline_cl, 'Na': spline_na, 'Mg': spline_mg,
               'SO4': spline_so4, 'Ca': spline_ca, 'NH4': spline_nh4}
SEQ_ION_DFS = {'K': df_k_ion, 'Cl': df_cl_ion, 'Na': df_na_ion, 'Mg': df_mg_ion,
               'SO4': df_so4_ion, 'Ca': df_ca_ion, 'NH4': df_nh4_ion}

# ==========================================
# 7c. JOINT SIMULTANEOUS MULTI-SALT FIT (v6)
# ==========================================
def run_joint_fit():
    print("\n" + "=" * 70)
    print("JOINT simultaneous multi-salt penalized LSQ fit")
    print("=" * 70)
    k_deg = 3
    IONS = list(ION_FREE_COL)
    STOICH = IonConductivityModel.SALT_STOICHIOMETRY

    # --- training equations: collapse replicates within (Salt, Source, T, m)
    keep_cols = ['Salt', 'Source', 'temp_K', 'Molality', 'Conductivity', 'I',
                 'Pressure_MPa', 'Temperature'] + list(ION_FREE_COL.values()) + \
        [c for c in PAIR_COLS if c in salt_dfs[JOINT_SALTS[0]].columns]
    parts = []
    for salt in JOINT_SALTS:
        d = salt_dfs[salt][keep_cols].copy()
        agg = {c: 'first' for c in keep_cols if c not in
               ('Salt', 'Source', 'temp_K', 'Molality', 'Conductivity')}
        agg['Conductivity'] = 'mean'
        d = d.groupby(['Salt', 'Source', 'temp_K', 'Molality'], as_index=False).agg(agg)
        parts.append(d)
    train = pd.concat(parts, ignore_index=True)
    n_eq = len(train)
    print(f"  {n_eq} salt equations from {JOINT_SALTS} "
          f"(replicates averaged within author; unit weights).")

    T_all = train['temp_K'].values
    x_all = np.sqrt(train['I'].values) if SQRT_I else train['I'].values
    kappa_all = train['Conductivity'].values
    eta_all = VISC.eta_multi(T_all, train['Pressure_MPa'].values)

    # pair conduction subtracted as a known external term
    b = kappa_all.copy()
    for salt in JOINT_SALTS:
        if PAIR_CONDUCTION and salt in SALT_PAIR_TERMS:
            msk = (train['Salt'] == salt).values
            cols = [c for c in SALT_PAIR_TERMS[salt] if c in train.columns]
            if cols and msk.any():
                b[msk] = b[msk] - pair_kappa(train[msk], T_all[msk],
                                             train['I'].values[msk], cols)

    # --- per-ion basis over that ion's data support -------------------
    def _knots(vals, n_int, k=3):
        lo, hi = float(vals.min()), float(vals.max())
        if hi - lo <= 0:
            raise ValueError('degenerate knot span')
        interior = np.array([])
        if n_int > 0:
            qs = np.linspace(0, 1, n_int + 2)[1:-1]
            interior = np.unique(np.quantile(vals, qs))
            interior = interior[(interior > lo + 1e-9) & (interior < hi - 1e-9)]
        return np.r_[[lo] * (k + 1), interior, [hi] * (k + 1)]

    def _basis(vals, knots, k=3):
        lo, hi = knots[k], knots[-k - 1]
        return BSpline.design_matrix(np.clip(vals, lo, hi), knots, k).toarray()

    def _d2(n):
        D = np.diff(np.eye(n), 2, axis=0)
        return D.T @ D

    ion_info = {}
    offset = 0
    for ion in IONS:
        salts_with = [s for s in JOINT_SALTS if ion in STOICH[s]]
        msk = train['Salt'].isin(salts_with).values
        t_sup, x_sup = T_all[msk], x_all[msk]
        kt = _knots(t_sup, JOINT_NT_INT, k_deg)
        kx = _knots(x_sup, JOINT_NX_INT, k_deg)
        ntc = len(kt) - k_deg - 1
        nxc = len(kx) - k_deg - 1
        alpha = SEQ_SPLINES[ion].alpha
        ion_info[ion] = dict(mask=msk, kt=kt, kx=kx, ntc=ntc, nxc=nxc,
                             off=offset, alpha=alpha,
                             t_sup=t_sup, I_sup=train['I'].values[msk])
        offset += ntc * nxc
        print(f"  {ion:4s}: support n={msk.sum():3d} from {salts_with}, "
              f"basis {ntc}x{nxc}, alpha={alpha:.3f} (from sequential)")
    n_coef = offset

    # --- assemble design (relative residuals: rows scaled by 1/kappa) --
    A = np.zeros((n_eq, n_coef))
    for ion, info in ion_info.items():
        msk = info['mask']
        m_free = train[ION_FREE_COL[ion]].values[msk]
        Bt = _basis(T_all[msk], info['kt'], k_deg)
        Bx = _basis(x_all[msk], info['kx'], k_deg)
        block = np.einsum('ij,ik->ijk', Bt, Bx).reshape(msk.sum(), -1)
        A[np.flatnonzero(msk), info['off']:info['off'] + block.shape[1]] = \
            block * (m_free / eta_all[msk] ** info['alpha'])[:, None]
    row_scale = 1.0 / kappa_all
    A_s = A * row_scale[:, None]
    b_s = b * row_scale

    # --- transport-number gauge anchors (KCl rows) --------------------
    kcl_msk = (train['Salt'] == 'KCl').values
    tp = calculate_t_kcl(train['Temperature'].values[kcl_msk],
                         train['Molality'].values[kcl_msk])
    rhs_anchor = tp * kappa_all[kcl_msk]
    infoK = ion_info['K']
    BtK = _basis(T_all[kcl_msk], infoK['kt'], k_deg)
    BxK = _basis(x_all[kcl_msk], infoK['kx'], k_deg)
    blockK = np.einsum('ij,ik->ijk', BtK, BxK).reshape(kcl_msk.sum(), -1)
    A_anchor = np.zeros((kcl_msk.sum(), n_coef))
    A_anchor[:, infoK['off']:infoK['off'] + blockK.shape[1]] = \
        blockK * (train[ION_FREE_COL['K']].values[kcl_msk] /
                  eta_all[kcl_msk] ** infoK['alpha'])[:, None]
    a_scale = ANCHOR_WEIGHT / rhs_anchor
    A_anchor_s = A_anchor * a_scale[:, None]
    b_anchor_s = np.full(kcl_msk.sum(), ANCHOR_WEIGHT, dtype=float)
    print(f"  + {kcl_msk.sum()} transport-number anchor equations (weight {ANCHOR_WEIGHT}).")

    # --- penalty (second differences per ion, trace-scaled) -----------
    A_full = np.vstack([A_s, A_anchor_s])
    b_full = np.concatenate([b_s, b_anchor_s])
    AtA_full = A_full.T @ A_full
    AtB_full = A_full.T @ b_full
    P_full = np.zeros((n_coef, n_coef))
    for ion, info in ion_info.items():
        ntc, nxc, off = info['ntc'], info['nxc'], info['off']
        P_i = np.kron(_d2(ntc), np.eye(nxc)) + np.kron(np.eye(ntc), _d2(nxc))
        sl = slice(off, off + ntc * nxc)
        tr_a = np.trace(AtA_full[sl, sl])
        tr_p = np.trace(P_i)
        P_full[sl, sl] = P_i * (tr_a / tr_p if tr_p > 0 else 1.0)

    def _solve(lam, A_t_A, A_t_b):
        try:
            return np.linalg.solve(A_t_A + lam * P_full, A_t_b)
        except np.linalg.LinAlgError:
            return np.linalg.lstsq(A_t_A + lam * P_full, A_t_b, rcond=None)[0]

    # --- CV over salt equations (anchors always in training) ----------
    rng = np.random.default_rng(JOINT_CV_SEED)
    idx = rng.permutation(n_eq)
    folds = np.array_split(idx, JOINT_CV_FOLDS)
    cv = []
    for lam in JOINT_LAM_FACTORS:
        sse, n_val = 0.0, 0
        for f in folds:
            tr_rows = np.setdiff1d(idx, f)
            A_tr = np.vstack([A_s[tr_rows], A_anchor_s])
            b_tr = np.concatenate([b_s[tr_rows], b_anchor_s])
            c = _solve(lam, A_tr.T @ A_tr, A_tr.T @ b_tr)
            r = A_s[f] @ c - b_s[f]
            sse += float(np.sum(r ** 2))
            n_val += len(f)
        cv.append((float(lam), np.sqrt(sse / n_val)))
    lam_best, cv_best = min(cv, key=lambda z: z[1])
    print(f"  CV({JOINT_CV_FOLDS}-fold) over lambda: best lam={lam_best:.3g} "
          f"(CV relative RMSE={cv_best:.3%}); grid "
          + ", ".join(f"{l:.0e}:{r:.3%}" for l, r in cv))
    c_hat = _solve(lam_best, AtA_full, AtB_full)
    r_train = A_s @ c_hat - b_s
    print(f"  joint training relative RMSE (all salt equations): "
          f"{np.sqrt(np.mean(r_train ** 2)):.3%}")
    for salt in JOINT_SALTS:
        msk = (train['Salt'] == salt).values
        print(f"    {salt:8s}: joint rel. RMSE = {np.sqrt(np.mean(r_train[msk] ** 2)):.3%} "
              f"(n={msk.sum()})")

    # --- wrap each ion surface into the IonSpline interface -----------
    joint = {}
    for ion, info in ion_info.items():
        C = c_hat[info['off']:info['off'] + info['ntc'] * info['nxc']] \
            .reshape(info['ntc'], info['nxc'])
        kt, kx = info['kt'], info['kx']
        t_lo, t_hi = kt[k_deg], kt[-k_deg - 1]
        x_lo, x_hi = kx[k_deg], kx[-k_deg - 1]
        t_grid = np.linspace(t_lo, t_hi, 80)
        x_grid = np.linspace(x_lo, x_hi, 80)
        Wg = _basis(t_grid, kt, k_deg) @ C @ _basis(x_grid, kx, k_deg).T
        joint[ion] = IonSpline.from_W_grid(
            t_grid, x_grid, Wg, info['t_sup'], info['I_sup'], info['alpha'],
            f'{ion} (joint)', lam_best)
    return joint, train, lam_best

if FIT_MODE == 'joint':
    JOINT_SPLINES, joint_train_df, JOINT_LAM = run_joint_fit()
    model = IonConductivityModel(speciation=spec_lookup)
    for ion, spl in JOINT_SPLINES.items():
        model.add_ion(ion, spl)
    spline_k, spline_cl = JOINT_SPLINES['K'], JOINT_SPLINES['Cl']
    spline_na, spline_mg = JOINT_SPLINES['Na'], JOINT_SPLINES['Mg']
    spline_so4, spline_ca = JOINT_SPLINES['SO4'], JOINT_SPLINES['Ca']
    spline_nh4 = JOINT_SPLINES['NH4']
    k_t_range, k_I_range = spline_k.t_range, spline_k.I_range
    cl_t_range, cl_I_range = spline_cl.t_range, spline_cl.I_range
    na_t_range, na_I_range = spline_na.t_range, spline_na.I_range
    mg_t_range, mg_I_range = spline_mg.t_range, spline_mg.I_range
    so4_t_range, so4_I_range = spline_so4.t_range, spline_so4.I_range
    ca_t_range, ca_I_range = spline_ca.t_range, spline_ca.I_range
    nh4_t_range, nh4_I_range = spline_nh4.t_range, spline_nh4.I_range

    # seq-vs-joint comparison on the training salts
    print("\n  Sequential vs joint on training salts (relative RMSE of kappa):")
    for salt in JOINT_SALTS:
        d = salt_dfs[salt]
        for name, mdl_ in [('seq', model_seq), ('joint', model)]:
            pred = np.atleast_1d(mdl_.predict_from_speciation(
                salt, d['temp_K'].values, d['Molality'].values, extrap_mode='linear'))
            ok = np.isfinite(pred)
            rel = np.sqrt(np.mean(((pred[ok] - d['Conductivity'].values[ok]) /
                                   d['Conductivity'].values[ok]) ** 2))
            print(f"    {salt:8s} {name:6s}: rel. RMSE={rel:.3%} on {ok.sum()}/{len(d)} rows")
else:
    print("\nFIT_MODE='sequential': sequential splines are the active model.")

