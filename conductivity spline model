        return fname
    from urllib.parse import quote
    return GITHUB_RAW + quote(GITHUB_PATHS.get(fname, fname))

# ---- constants and thresholds ----------------------------------------
MIN_POINTS = 16                   # minimum points to fit an ion surface
REFERENCE_PRESSURE_MPA = 0.1
AMBIENT_P_TOL_MPA = 0.05          # a row is ambient if |P - 0.1 MPa| <= this
SUBTRACTION_FRACTION_MAX = 0.90   # deconvolution: max known-ion share of kappa
MIN_FREE_MOLALITY_MOLKG = 1e-4    # deconvolution: min free molality of new ion
OUTLIER_REL_RESID_MAX = 0.25      # relative residual above which a point is
                                  # excluded and the surface refit once
