                         f'carry a single-salt name and would enter a fit pool.')

def _assert_units(df):
    """Cheap unit sanity checks: Mahboub NaCl must agree with McCleskey NaCl
    at 25 C within 15%, and MgSO4 near 25 C / 0.3-1.0 mol/kg must land in
    10-100 mS/cm (an S/m vs mS/cm mixup would fail both)."""
    mc = df[(df['Source'] == 'McCleskey2011') & (df['Salt'] == 'NaCl') &
            (df['Temperature_C'] == 25.0)].sort_values('Molality_molkg')
    mh = df[(df['Source'] == 'Mahboub') & (df['Salt'] == 'NaCl') &
            (df['Temperature_C'] == 25.0)]
    if len(mc) >= 3 and len(mh) >= 1:
        inside = mh[(mh['Molality_molkg'] >= mc['Molality_molkg'].min()) &
                    (mh['Molality_molkg'] <= mc['Molality_molkg'].max())]
        if len(inside) >= 1:
            kappa_interp = np.interp(inside['Molality_molkg'].values,
                                     mc['Molality_molkg'].values,
                                     mc['Conductivity_mScm'].values)
            ratio = inside['Conductivity_mScm'].values / kappa_interp
            if np.any((ratio < 0.85) | (ratio > 1.15)):
                raise ValueError(
                    'Unit guard: Mahboub NaCl disagrees with McCleskey NaCl at 25 C '
                    f'by more than 15% (ratios: {np.round(ratio, 3)}).')
    mg = df[(df['Salt'] == 'MgSO4') & (df['Temperature_C'].between(20.0, 25.0)) &
            (df['Molality_molkg'].between(0.3, 1.0)) &
            ((df['Pressure_MPa'] - REFERENCE_PRESSURE_MPA).abs() <= AMBIENT_P_TOL_MPA)]
    if len(mg) >= 1:
        k = mg['Conductivity_mScm'].dropna().values
        if len(k) and np.any((k < 10.0) | (k > 100.0)):
            raise ValueError(
                'Unit guard: MgSO4 conductivity near 25 C / 0.3-1.0 mol/kg outside '
                f'10-100 mS/cm (found {np.round(k, 2)}). Suspect S/m vs mS/cm.')
    print('Unit guard passed.')
_assert_units(df)

is_training_row = df['Source'].isin(TRAINING_SOURCES) & df['Salt'].isin(ALL_SALTS)
is_promoted_row = pd.Series(False, index=df.index)
for _src, _salts in PROMOTED_SALTS_BY_SOURCE.items():
    is_promoted_row |= (df['Source'] == _src) & df['Salt'].isin(_salts)
is_heldout_extra = pd.Series(False, index=df.index)
for _src, _salts in HELDOUT_EXTRA_SOURCES.items():
    _hit = (df['Source'] == _src) & df['Salt'].isin(_salts)
    if not _hit.any():
