# KCl TRANSPORT NUMBER
# ==========================================
_TKCL_A, _TKCL_B, _TKCL_C = 9.04e-7, -2.35e-4, 0.4960

def calculate_t_kcl(temp_C, molality):
    """K+ transport number in KCl, in the form used by McCleskey (EA1):
        t+(T) = 9.04e-7*T_C^2 - 2.35e-4*T_C + 0.4960
    minus a small concentration term. The quadratic was fitted to literature
    transport-number data spanning roughly 0-100 C and molalities up to
    about 1 mol/kg.

    The positive T^2 coefficient makes the parabola turn upward at low
    temperature, which is unphysical, so the quadratic is never evaluated
    outside 0-100 C: below 0 C the function continues linearly along the
    tangent at 0 C, above 100 C along the tangent at 100 C (both C1 at the
    boundary). The concentration term is kept as-is at all temperatures.
    A note is printed whenever tangent extrapolation is used."""
    temp_C = np.atleast_1d(np.asarray(temp_C, dtype=float))
    def _q(t):
        return _TKCL_A * t * t + _TKCL_B * t + _TKCL_C
    def _dq(t):
        return 2.0 * _TKCL_A * t + _TKCL_B
    term1 = _q(np.clip(temp_C, 0.0, 100.0))
    below = temp_C < 0.0
    above = temp_C > 100.0
    if below.any():
        term1 = np.where(below, _q(0.0) + _dq(0.0) * temp_C, term1)
        print(f"  t+(KCl): tangent extrapolation below 0 C applied to "
              f"{int(below.sum())} point(s), T in "
              f"[{temp_C[below].min():.1f}, {temp_C[below].max():.1f}] C.")
    if above.any():
        term1 = np.where(above, _q(100.0) + _dq(100.0) * (temp_C - 100.0), term1)
        print(f"  t+(KCl): tangent extrapolation above 100 C applied to "
              f"{int(above.sum())} point(s), T in "
              f"[{temp_C[above].min():.1f}, {temp_C[above].max():.1f}] C.")
    sqrt_m = np.sqrt(np.asarray(molality, dtype=float))
    term2 = 0.0027 * (sqrt_m / (1.0 + 0.05 * sqrt_m))
    return term1 - term2

