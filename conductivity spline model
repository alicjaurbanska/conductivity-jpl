ISOTHERM_ROUND_K = 1.0            # isotherm grouping step for CV folds

# ---- infinite-dilution anchors ---------------------------------------
# Each ion surface is fitted with synthetic rows at I = 0 carrying
# Lambda = lambda_0(T), so the low-I edge follows the known limiting values
# instead of an unconstrained extrapolation of the measured data.
ANCHOR_LAMBDA0 = True
ANCHOR_SOURCE = 'anchor_lambda0'      # own Source label, so anchors form their
                                      # own CV groups and stay visible in
                                      # every diagnostic
ANCHOR_N_T = 15                       # anchor temperatures per ion
ANCHOR_T_WINDOW_K = (273.15, 368.15)  # validity window of the lambda_0 fits

# lambda_0(T_C) = a*T_C^2 + b*T_C + c from McCleskey et al. (2012) Table 1,
# in mS kg cm^-1 mol^-1, valid 0-95 C. Note these coefficients (and the pair
# coefficients below) also sit inside the McCleskey model used as the
# comparison baseline, so the two models share this input.
LAMBDA0_MC12 = {
    'K':   (0.003046, 1.261,  40.70),
    'Na':  (0.003763, 0.8770, 26.23),
    'NH4': (0.003341, 1.285,  39.04),
    'Ca':  (0.009645, 1.984,  62.28),
    'Mg':  (0.01068,  1.695,  57.16),
    'SO4': (0.01037,  2.838,  82.37),
    'Cl':  (0.003817, 1.337,  40.99),
}

def lambda0_ion(ion, T_K):
    """Limiting single-ion molal conductivity lambda_0(T), McCleskey et al.
    (2012) Table 1 quadratics."""
    a, b, c = LAMBDA0_MC12[ion]
    T_C = np.asarray(T_K, dtype=float) - 273.15
    return a * T_C**2 + b * T_C + c

def make_anchor_rows(ion, T_lo_K, T_hi_K):
    """Synthetic training rows at I = 0 with Lambda = lambda_0(T). Exact by
    definition of the infinite-dilution limit; they enter the fit like any
    measured point (Walden-transformed inside IonSpline). Clipped to the
    0-95 C validity window of the lambda_0 quadratics; returns None if the
    ion's data lie entirely outside that window."""
    lo = max(float(T_lo_K), ANCHOR_T_WINDOW_K[0])
    hi = min(float(T_hi_K), ANCHOR_T_WINDOW_K[1])
    if hi <= lo:
        return None
    T = np.linspace(lo, hi, ANCHOR_N_T)
    return pd.DataFrame({
        'Source': ANCHOR_SOURCE, 'temp_K': T, 'I': 0.0, 'Molality': 0.0,
        'Lambda': lambda0_ion(ion, T),
        'From_Extrapolated_Known': False,
    })

# ---- CV settings for smoothing selection -----------------------------
CV_FOLDS = 5
CV_SEED = 0
CV_MIN_POINTS = 30
S_GRID_FACTORS = np.geomspace(1e-6, 1.0, 13)

# ==========================================
# McCLESKEY (2012) ION-PAIR CONDUCTIVITIES
# ==========================================
# KSO4- and NaSO4- are charged and conduct; no ionic spline exists for them,
# so their molar conductivities come from the McCleskey et al. (2012) Table 1
# expressions: lambda(T, I) = lam0(T) - A(T)*sqrt(I)/(1 + B*sqrt(I)),
# with lam0 and A quadratic in T_C. Two caveats: the coefficients were
# originally regressed with WATEQ4F speciation while this model feeds them
# SUPCRT molalities, and the expressions are ambient-only in T and sqrt(I)
# (no Walden transform). MgSO4(aq) is neutral and contributes zero.
PAIR_CONDUCTION = True
MC12_PAIR_COEFFS = {
    # (lam0: a, b, c), (A: p, q, r), B
    'KSO4':  ((-0.002439, 4.253, 129.7), (-0.01576, 6.210, 146.8), 1.3),
    'NaSO4': ((0.002309, 5.459, 219.2), (0.01454, 5.193, 253.6), 0.5),
}
PAIR_LAMBDA_FOR_COL = {'m_pair_KSO4': 'KSO4', 'm_pair_NaSO4': 'NaSO4'}
SALT_PAIR_TERMS = {'K2SO4': ['m_pair_KSO4'], 'Na2SO4': ['m_pair_NaSO4']}

def mc12_pair_lambda(pair_key, T_K, I):
    """Molar conductivity of a charged ion pair (KSO4- or NaSO4-) from the
    McCleskey et al. (2012) Table 1 coefficients."""
    (a, b, c), (p, q, r), B = MC12_PAIR_COEFFS[pair_key]
    T_C = np.asarray(T_K, dtype=float) - 273.15
    sqrt_I = np.sqrt(np.asarray(I, dtype=float))
    lam0 = a * T_C**2 + b * T_C + c
    A = p * T_C**2 + q * T_C + r
    return lam0 - A * sqrt_I / (1.0 + B * sqrt_I)

def pair_conduction_mc12(source_df_or_cols, T_K, I, pair_cols):
    """Total conductivity contribution (mS/cm) of the charged ion pairs,
    given their molality columns. Used identically in training (pair term
    subtracted before deconvolution) and prediction (pair term added)."""
    total = np.zeros_like(np.atleast_1d(np.asarray(T_K, dtype=float)))
    for col in pair_cols:
        key = PAIR_LAMBDA_FOR_COL[col]
        m_pair = np.asarray(source_df_or_cols[col], dtype=float)
        total = total + np.nan_to_num(m_pair) * mc12_pair_lambda(key, T_K, I)
    return total

