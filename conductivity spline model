def _clean_speciated_rows(d, tag, require_ambient):
    """Rename working columns and apply the ambient policy: McCleskey2011
    rows are ambient by definition (their measurements above 100 C are
    saturated-liquid states, which the viscosity table reproduces); other
    sources are ambient iff |P - 0.1 MPa| <= AMBIENT_P_TOL_MPA.
    require_ambient=True (all fit salts and validation stashes) drops
    non-ambient rows; test-only pools keep them, tagged Ambient=False, so
    they never enter a fit but remain available for inspection."""
    d = d.copy()
    if d.empty:
        raise ValueError(f"No rows found for {tag}. Check CSV.")
    d = d[~d['Molality_molkg'].isna()].copy()
    if d.empty:
        raise ValueError(f'{tag} has no usable rows left.')
    if d['I_eff'].isna().any():
        raise RuntimeError(f'{tag}: unspeciated rows survived the merge assertion - bug.')
    d = d.rename(columns={'Molality_molkg': 'Molality', 'Temperature_C': 'Temperature',
                          'Conductivity_mScm': 'Conductivity'})
    d['temp_K'] = d['Temperature'] + 273.15
    d['I'] = d['I_eff']
    d['Ambient'] = (d['Source'] == 'McCleskey2011') | \
        ((d['Pressure_MPa'] - REFERENCE_PRESSURE_MPA).abs() <= AMBIENT_P_TOL_MPA)
    if require_ambient:
        n_bad = int((~d['Ambient']).sum())
        if n_bad:
            _bad = d[~d['Ambient']]
            print(f"  Ambient policy [{tag}]: excluding {n_bad}/{len(d)} non-ambient "
                  f"row(s) (P {_bad['Pressure_MPa'].min():.2f}-"
                  f"{_bad['Pressure_MPa'].max():.2f} MPa) from all fitting.")
            d = d[d['Ambient']].copy()
        if d.empty:
            raise ValueError(f'{tag} has no ambient rows.')
    d = d.sort_values(['Source', 'temp_K', 'I'], kind='mergesort').reset_index(drop=True)
    return d

def _iapws_filter(d, tag):
    """Drop rows outside the viscosity table's temperature range (the Walden
    transform is undefined there)."""
    ok_T, n_T, T_rng = VISC.coverage_check(d['temp_K'].values)
    if n_T > 0:
        print(f"  Viscosity floor [{tag}]: excluding {n_T}/{len(d)} rows below "
              f"{WaterViscosity.T_MIN:.2f} K (excluded: "
              f"{T_rng[0]-273.15:.1f} to {T_rng[1]-273.15:.1f} C).")
        d = d[ok_T].copy()
    hot = d['temp_K'].values > WaterViscosity.T_MAX
    if hot.any():
        print(f"  Viscosity ceiling [{tag}]: excluding {int(hot.sum())}/{len(d)} rows above "
              f"{WaterViscosity.T_MAX:.2f} K (max in data: {d['Temperature'].max():.1f} C).")
        d = d[~hot].copy()
    if d.empty:
        raise ValueError(f'{tag}: no rows left inside the viscosity table range.')
    return d

