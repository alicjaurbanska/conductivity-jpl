              f"(available: {sorted(df['Source'].unique())}).")
    is_heldout_extra |= _hit
is_validation_row = pd.Series(False, index=df.index)
for _src, _salts in VALIDATION_SALTS_BY_SOURCE.items():
    is_validation_row |= (df['Source'] == _src) & df['Salt'].isin(_salts)
_keep = (is_training_row | is_promoted_row | is_validation_row | is_heldout_extra)
_dropped = df[~_keep & df['Salt'].isin(ALL_SALTS)]
