def plot_ion_spline(spline, t_range, I_range, ion_df, title, ax, n_points=60):
    Tg, Ig = np.meshgrid(np.linspace(t_range[0], t_range[1], n_points),
                         np.linspace(I_range[0], I_range[1], n_points))
    Z = spline.ev_or_nan(Tg.ravel(), Ig.ravel()).reshape(Tg.shape)
    surf = ax.plot_surface(Tg, Ig, Z, cmap='viridis', linewidth=0, antialiased=True, alpha=0.9)
    ax.scatter(ion_df['temp_K'], ion_df['I'], ion_df['Lambda'],
               color='black', s=6, depthshade=False)
    ax.set_title(title, pad=0)
    ax.set_xlabel('T (K)', labelpad=2)
    ax.set_ylabel('I$_{eff}$ (mol kg$^{-1}$)', labelpad=2)
    ax.set_zlabel(r'$\lambda_i$ (mS cm$^{-1}$ M$^{-1}$)', labelpad=2)
    ax.tick_params(pad=0, labelsize=8)
    return surf

# ==========================================
# 0.2 WATER VISCOSITY (IAPWS-95 + IAPWS 2008, cached per pressure)
# ==========================================
class WaterViscosity:
    """eta_water(T, P) in mPa s. Supercooled branch below 273.15 K (floor
    250.15 K). Above 372 K at low P the liquid does not exist at the
    nominal pressure, so the SATURATED-LIQUID state is used (liquid eta is
    nearly P-independent there); table extends to 623.15 K."""
    T_MIN, T_MAX, N_GRID = 250.15, 623.15, 400
    def __init__(self):
        self._cache = {}
    def _key(self, P_MPa):
        return round(float(P_MPa), 4)
    def _build(self, P_MPa):
        try:
            from iapws import IAPWS95
        except ImportError:
            raise ImportError("WALDEN mode needs the iapws package: `!pip install iapws`.")
        T_grid, eta_grid = [], []
        n_sat = 0
        with warnings.catch_warnings():
            warnings.simplefilter('ignore')
            for T in np.linspace(self.T_MIN, self.T_MAX, self.N_GRID):
                try:
                    w = None
                    if T > 372.0:
                        sat = IAPWS95(T=float(T), x=0)
                        Psat = getattr(sat, 'P', None)
                        if Psat is not None and float(P_MPa) < Psat:
                            w = sat
                            n_sat += 1
                    if w is None:
                        w = IAPWS95(T=float(T), P=float(P_MPa))
                    mu = getattr(w, 'mu', None)
                    if mu is not None and np.isfinite(mu) and mu > 0:
                        T_grid.append(T)
                        eta_grid.append(mu * 1000.0)
                except Exception:
                    continue
        if len(T_grid) < 20:
            raise RuntimeError(f'WaterViscosity: IAPWS table build failed at P={P_MPa} MPa '
                               f'({len(T_grid)} usable points).')
        T_grid = np.asarray(T_grid)
        spl = UnivariateSpline(T_grid, np.asarray(eta_grid), k=3, s=0)
        self._cache[self._key(P_MPa)] = (spl, spl.derivative(), T_grid.min(), T_grid.max())
        sat_note = f' ({n_sat} hot points on the saturated-liquid branch)' if n_sat else ''
        print(f'  WaterViscosity: built eta(T) table at P={P_MPa} MPa, '
              f'valid {T_grid.min():.1f}-{T_grid.max():.1f} K{sat_note}.')
    def _get(self, P_MPa):
        k = self._key(P_MPa)
        if k not in self._cache:
            self._build(P_MPa)
        return self._cache[k]
    def eta(self, T_K, P_MPa):
        spl, _, lo, hi = self._get(P_MPa)
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        if np.any((T_K < lo) | (T_K > hi)):
            raise ValueError(f'WaterViscosity: T outside tabulated {lo:.1f}-{hi:.1f} K '
                             f'at P={P_MPa} MPa.')
        return spl(T_K)
    def eta_multi(self, T_K_array, P_MPa_array):
        T_K_array = np.atleast_1d(np.asarray(T_K_array, dtype=float))
        P_MPa_array = np.atleast_1d(np.asarray(P_MPa_array, dtype=float))
        if P_MPa_array.size == 1:
            P_MPa_array = np.full_like(T_K_array, P_MPa_array.item())
        out = np.empty_like(T_K_array)
        for p in np.unique(P_MPa_array):
            mask = P_MPa_array == p
            out[mask] = self.eta(T_K_array[mask], p)
        return out
    def deta_dT(self, T_K, P_MPa):
        _, dspl, lo, hi = self._get(P_MPa)
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        return dspl(np.clip(T_K, lo, hi))
    def coverage_check(self, T_K_array):
        T_K_array = np.atleast_1d(np.asarray(T_K_array, dtype=float))
        ok = T_K_array >= self.T_MIN
        n_excluded = int((~ok).sum())
        T_range_excluded = None
        if n_excluded > 0:
            excl = T_K_array[~ok]
            T_range_excluded = (float(excl.min()), float(excl.max()))
        return ok, n_excluded, T_range_excluded

VISC = WaterViscosity()

# ==========================================
# 0.3 CV SMOOTHING SELECTION (sequential chain)
# ==========================================
def _fit_sbs(t, x, z, w, kx, ky, s):
    with warnings.catch_warnings():
        warnings.simplefilter('ignore')
        return SmoothBivariateSpline(t, x, z, w=w, kx=kx, ky=ky, s=s)

def select_s_by_cv(t, x, z, w, kx, ky, label):
    m = len(t)
    s_heur = m - np.sqrt(2 * m)
    if m < CV_MIN_POINTS:
        print(f"  {label}: only {m} points (< {CV_MIN_POINTS}) - skipping CV, "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    zbar = np.average(z, weights=w)
    S_var = float(np.sum((w * (z - zbar)) ** 2))
    s_grid = S_var * S_GRID_FACTORS
    rng = np.random.default_rng(CV_SEED)
    idx = rng.permutation(m)
    folds = np.array_split(idx, CV_FOLDS)
    n_par = (kx + 1) * (ky + 1)
    results = []
    for s in s_grid:
        sse, sw = 0.0, 0.0
        ok = True
        for f in folds:
            tr = np.setdiff1d(idx, f)
            if len(tr) < n_par + 4:
                ok = False
                break
            try:
                spl = _fit_sbs(t[tr], x[tr], z[tr], w[tr], kx, ky, s)
                pred = spl.ev(t[f], x[f])
            except Exception:
                ok = False
                break
            if not np.all(np.isfinite(pred)):
                ok = False
                break
            sse += float(np.sum(w[f] * (z[f] - pred) ** 2))
            sw += float(np.sum(w[f]))
        if ok and sw > 0:
            results.append((float(s), np.sqrt(sse / sw)))
    if not results:
        print(f"  {label}: CV failed for every s candidate - "
              f"using FITPACK heuristic s={s_heur:.3g}.")
        return s_heur, None
    s_best, rmse_best = min(results, key=lambda r: r[1])
    z_scale = np.average(np.abs(z), weights=w)
    print(f"  {label}: CV({CV_FOLDS}-fold) chose s={s_best:.4g} "
          f"(factor {s_best / S_var:.1e} of weighted variance), "
          f"CV RMSE={rmse_best:.4g} ({rmse_best / z_scale:.2%} of mean |W|), "
          f"{len(results)}/{len(s_grid)} candidates viable.")
    return s_best, results

# ==========================================
# 0.4 SPLINE WRAPPER
# ==========================================
class IonSpline:
    """Bicubic surface over (T, sqrt(I_eff)) with a lambda-space interface.
    Two construction paths:
      - __init__: scattered CV-smoothed fit (sequential chain, v5.2)
      - from_W_grid: wrap a precomputed W(T, x) coefficient surface
        (joint fit, v6) with hull taken from the ion's data support.
    WALDEN: lambda(T, P, I) = W(T, sqrt I) / eta_water(T, P)^alpha."""
    def __init__(self, t, I, lambda_val, label, s=None, w=None, kx=3, ky=3,
                 P_ref_MPa=REFERENCE_PRESSURE_MPA, P_MPa=None):
        self.label = label
        self.P_ref = P_ref_MPa
        t = np.asarray(t, dtype=float)
        I = np.asarray(I, dtype=float)
        lambda_val = np.asarray(lambda_val, dtype=float)
        P_train = np.full_like(t, P_ref_MPa) if P_MPa is None else np.asarray(P_MPa, dtype=float)
        self.P_train_range = (float(P_train.min()), float(P_train.max()))
        w = np.ones_like(t) if w is None else np.asarray(w, dtype=float) / np.mean(w)
        if WALDEN:
            self.alpha = self._fit_alpha(t, I, lambda_val, P_train) \
                if WALDEN_ALPHA_FIT else 1.0
            z_fit = lambda_val * VISC.eta_multi(t, P_train) ** self.alpha
        else:
            self.alpha = 1.0
            z_fit = lambda_val
        n_t, n_I = len(np.unique(t)), len(np.unique(I))
        if n_t < kx + 1 or n_I < ky + 1:
            raise ValueError(
                f"{label}: a bidegree-{kx} spline needs >= {kx + 1} distinct T values "
                f"and >= {ky + 1} distinct I values; got {n_t} T levels, {n_I} I levels.")
        x = self._x(I)
        if s is None:
            s_used, self.cv_table = select_s_by_cv(t, x, z_fit, w, kx, ky, label)
        else:
            s_used, self.cv_table = s, None
        last_err = None
        for _ in range(6):
            try:
                self._spline = _fit_sbs(t, x, z_fit, w, kx, ky, s_used)
                break
            except Exception as e:
                last_err = e
                s_used *= 2.0
                print(f"  {label}: fit failed at s={s_used / 2:.4g} ({e}); retrying s={s_used:.4g}.")
        else:
            raise RuntimeError(f"{label}: spline fit failed even after relaxing s: {last_err}")
        self.s_used = s_used
        self.method = f'scattered CV (SmoothBivariateSpline, s={s_used:.3g})'
        self.method += (f' [Walden a={self.alpha:.3f}, '
                        f'P {self.P_train_range[0]:.1f}-{self.P_train_range[1]:.1f} MPa]'
                        if WALDEN else ' [raw lambda]')
        self._hull = Delaunay(np.column_stack([t, x]))
        self.t_range = (float(t.min()), float(t.max()))
        self.I_range = (float(I.min()), float(I.max()))
        self.validate_physics()

    @classmethod
    def from_W_grid(cls, t_grid, x_grid, W_grid, support_t, support_I, alpha,
                    label, lam_used, P_ref_MPa=REFERENCE_PRESSURE_MPA,
                    P_train_range=(REFERENCE_PRESSURE_MPA, REFERENCE_PRESSURE_MPA)):
        """Wrap a joint-fit W surface (values on a dense rectangular grid in
        (T, x) space) into the standard IonSpline interface. Hull and ranges
        come from the ion's actual data support, so out-of-data queries are
        masked exactly as in the sequential path."""
        self = cls.__new__(cls)
        self.label = label
        self.P_ref = P_ref_MPa
        self.P_train_range = P_train_range
        self.alpha = float(alpha)
        self._spline = RectBivariateSpline(t_grid, x_grid, W_grid, kx=3, ky=3, s=0)
        self.s_used = lam_used
        self.cv_table = None
        self.method = f'joint penalized LSQ (lam={lam_used:.3g}) [Walden a={alpha:.3f}]'
        support_t = np.asarray(support_t, dtype=float)
        support_I = np.asarray(support_I, dtype=float)
        self._hull = Delaunay(np.column_stack([support_t, self._x(support_I)]))
        self.t_range = (float(support_t.min()), float(support_t.max()))
        self.I_range = (float(support_I.min()), float(support_I.max()))
        self.validate_physics()
        return self

    @staticmethod
    def _fit_alpha(t, I, lam, P_MPa):
        eta = VISC.eta_multi(t, P_MPa)
        s = np.sqrt(np.asarray(I, dtype=float))
        A = np.column_stack([np.ones_like(s), s, s * s, np.log(eta)])
        coef, *_ = np.linalg.lstsq(A, np.log(np.asarray(lam, dtype=float)), rcond=None)
        return float(np.clip(-coef[3], 0.5, 1.2))
    def _in_hull(self, t_query, I_query):
        return self._hull.find_simplex(np.column_stack([t_query, self._x(I_query)])) >= 0
    def _x(self, I):
        return np.sqrt(I) if SQRT_I else np.asarray(I, dtype=float)
    def _eta(self, t_query, P_MPa):
        P = self.P_ref if P_MPa is None else P_MPa
        return VISC.eta_multi(t_query, P)
    def W(self, t_query, I_query):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        z = self._spline.ev(t_query, self._x(I_query))
        return np.where(self._in_hull(t_query, I_query), z, np.nan)
    def ev_or_nan(self, t_query, I_query, P_MPa=None):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        z = self._spline.ev(t_query, self._x(I_query))
        if WALDEN:
            z = z / self._eta(t_query, P_MPa) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), z, np.nan)
    def ev(self, t_query, I_query, P_MPa=None):
        result = self.ev_or_nan(t_query, I_query, P_MPa)
        if np.any(np.isnan(result)):
            raise ValueError(f"{self.label} spline: query point(s) outside the convex hull.")
        return result if result.size > 1 else result.item()
    def ev_extrap(self, t_query, I_query, mode='linear', T_max_K=30.0, P_MPa=None):
        if not WALDEN:
            raise RuntimeError('ev_extrap requires WALDEN = True.')
        T = np.atleast_1d(np.asarray(t_query, dtype=float))
        I = np.atleast_1d(np.asarray(I_query, dtype=float))
        x = self._x(I)
        T_edge = np.full_like(T, self.t_range[0])
        ok = self._hull.find_simplex(np.column_stack([T_edge + 1e-6, x])) >= 0
        ok &= (T >= self.t_range[0] - T_max_K)
        W = self._spline.ev(T_edge, x)
        if mode == 'linear':
            W = W + self._spline.ev(T_edge, x, dx=1) * (T - T_edge)
        elif mode != 'constant':
            raise ValueError(f"ev_extrap mode must be 'constant' or 'linear', got {mode}")
        P = self.P_ref if P_MPa is None else P_MPa
        lam = W / VISC.eta_multi(T, P) ** self.alpha
        return np.where(ok, lam, np.nan)
    def dT(self, t_query, I_query, P_MPa=None):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        dW = self._spline.ev(t_query, self._x(I_query), dx=1, dy=0)
        if WALDEN:
            P = self.P_ref if P_MPa is None else P_MPa
            eta = self._eta(t_query, P_MPa)
            eta_a = eta ** self.alpha
            lam = self._spline.ev(t_query, self._x(I_query)) / eta_a
            val = dW / eta_a - self.alpha * lam * VISC.deta_dT(t_query, P) / eta
        else:
            val = dW
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def dI_val(self, t_query, I_query, P_MPa=None):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        g = self._spline.ev(t_query, self._x(I_query), dx=0, dy=1)
        val = g / (2 * np.sqrt(I_query)) if SQRT_I else g
        if WALDEN:
            val = val / self._eta(t_query, P_MPa) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def d2I_val(self, t_query, I_query, P_MPa=None):
        t_query, I_query = np.atleast_1d(t_query), np.atleast_1d(I_query)
        g1 = self._spline.ev(t_query, self._x(I_query), dx=0, dy=1)
        g2 = self._spline.ev(t_query, self._x(I_query), dx=0, dy=2)
        if SQRT_I:
            u = np.sqrt(I_query)
            val = g2 / (4 * I_query) - g1 / (4 * I_query * u)
        else:
            val = g2
        if WALDEN:
            val = val / self._eta(t_query, P_MPa) ** self.alpha
        return np.where(self._in_hull(t_query, I_query), val, np.nan)
    def validate_physics(self):
        t_vals = np.linspace(self.t_range[0], self.t_range[1], 50)
        I_lo = max(1e-6, self.I_range[0])
        I_vals = np.geomspace(I_lo, self.I_range[1], 50)
        Tg, Ig = np.meshgrid(t_vals, I_vals)
        Tg_flat, Ig_flat = Tg.ravel(), Ig.ravel()
        inside = self._in_hull(Tg_flat, Ig_flat)
        Ti, Ii = Tg_flat[inside], Ig_flat[inside]
        if len(Ti) == 0:
            return
        lam = self.ev_or_nan(Ti, Ii)
        dT = self.dT(Ti, Ii)
        dI = self.dI_val(Ti, Ii)
        d2I = self.d2I_val(Ti, Ii)
        def _report(name, values, mask, worst_fn):
            n = int(mask.sum())
            if n == 0:
                return None
            worst = worst_fn(values[mask])
            scale = np.median(np.abs(values[np.isfinite(values)]))
            frac = abs(worst) / scale if scale > 0 else float('nan')
            return (f"{n} points have {name} (worst={worst:.4g}, "
                    f"typical scale={scale:.4g}, worst/typical={frac:.1%})")
        violations = [v for v in [
            _report('lam < 0', lam, lam < 0, np.min),
            _report('dT < 0', dT, dT < 0, np.min),
            _report('dI > 0', dI, dI > 0, np.max),
            _report('d2I < 0', d2I, d2I < 0, np.min),
        ] if v is not None]
        if violations:
            print(f"  [PHYSICS WARNING for {self.label}]: violations inside hull:")
            for v in violations:
                print(f"    - {v}")

