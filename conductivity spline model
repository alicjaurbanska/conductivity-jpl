# Single-ion conductivity model for aqueous brines.
#
# Bicubic spline surfaces of the Walden product W_i = lambda_i * eta(T)^alpha_i
# over (T, sqrt(I_eff)), one surface per ion, built by sequential deconvolution
# of binary-salt conductivity data. Solution conductivity is reconstructed as
# kappa = sum_i m_free_i * lambda_i plus the conductivity of charged ion pairs
# (KSO4-, NaSO4-), for which the McCleskey et al. (2012) Table 1 expressions
# are used. The same table supplies the infinite-dilution lambda_0(T) values
# used to anchor each surface at I = 0. Ambient pressure only.

import os
import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.interpolate import (SmoothBivariateSpline, LinearNDInterpolator,
                               UnivariateSpline)
from scipy.spatial import Delaunay

