def fit_lambda_spline(d, label, t_col='temp_K', I_col='I', lambda_col='Lambda',
                      s=None, anchor_ion=None):
    """Fit one ion surface.

    Replicates: rows sharing (Source, T, I) are averaged into one
    unit-weight point; different labs stay separate points. Rows are put in
    a canonical (Source, T, I) order first so the fit does not depend on CSV
    row order. CV folds are grouped by (Source, isotherm), with isotherm =
    T rounded to ISOTHERM_ROUND_K.

    If anchor_ion names an ion in LAMBDA0_MC12, lambda_0 rows at I = 0 are
    appended before fitting - unless the frame already carries them, so a
    refit after the residual filter never double-adds anchors."""
    d = d.copy()
    if ANCHOR_LAMBDA0 and anchor_ion in LAMBDA0_MC12 and \
            not (d['Source'] == ANCHOR_SOURCE).any():
        anc = make_anchor_rows(anchor_ion, d[t_col].min(), d[t_col].max())
        if anc is not None:
            anc = anc.reindex(columns=d.columns)  # align; absent cols -> NaN
            d = pd.concat([d, anc], ignore_index=True)
            print(f"  {label}: appended {len(anc)} lambda_0 anchor rows at I=0 "
                  f"(Source='{ANCHOR_SOURCE}', T "
                  f"{anc['temp_K'].min():.1f}-{anc['temp_K'].max():.1f} K).")
        else:
            print(f"  {label}: no lambda_0 anchors - data T range lies outside "
                  f"the {ANCHOR_T_WINDOW_K[0]:.1f}-{ANCHOR_T_WINDOW_K[1]:.1f} K "
                  f"validity window.")
    d = d.sort_values(['Source', t_col, I_col] if 'Source' in d.columns
                      else [t_col, I_col], kind='mergesort').reset_index(drop=True)
    n_before = len(d)
    group_cols = (['Source'] if 'Source' in d.columns else []) + [t_col, I_col]
    other_cols = [c for c in d.columns if c not in group_cols + [lambda_col]]
    grouped = d.groupby(group_cols, as_index=False).agg(
        **{lambda_col: (lambda_col, 'mean')},
        _n_reps=(lambda_col, 'size'),
        _lambda_std=(lambda_col, 'std'),
    )
    if other_cols:
        agg_map = {c: ('max' if c == 'From_Extrapolated_Known' else 'first')
                   for c in other_cols}
        firsts = d.groupby(group_cols, as_index=False).agg(agg_map)
        grouped = grouped.merge(firsts, on=group_cols)
    d = grouped
    n_collapsed = int((d['_n_reps'] > 1).sum())
    if n_collapsed > 0:
        max_reps = int(d['_n_reps'].max())
        rel_spread = (d.loc[d['_n_reps'] > 1, '_lambda_std'] /
                      d.loc[d['_n_reps'] > 1, lambda_col].abs())
        worst_spread = float(rel_spread.max()) if len(rel_spread) else 0.0
        print(f"  {label}: collapsed {n_before} rows -> {len(d)} unique "
              f"(Source, T, I) points "
              f"({n_collapsed} conditions averaged over up to {max_reps} within-author "
              f"replicates, worst relative std = {worst_spread:.2%}; all points weight 1).")
    d = d.drop(columns=['_n_reps', '_lambda_std'])
    d = d.sort_values(['Source', t_col, I_col] if 'Source' in d.columns
                      else [t_col, I_col], kind='mergesort').reset_index(drop=True)
    if len(d) < MIN_POINTS:
        raise ValueError(f"{label} has too few points ({len(d)}).")
    iso = np.round(d[t_col].values / ISOTHERM_ROUND_K).astype(int)
    if 'Source' in d.columns:
        groups = np.array([f"{s_}|T{i_}" for s_, i_ in zip(d['Source'].values, iso)])
    else:
        groups = np.array([f"T{i_}" for i_ in iso])
    spline = IonSpline(d[t_col].values, d[I_col].values, d[lambda_col].values, label,
                       s=s, groups=groups)
    fitted = spline.ev(d[t_col].values, d[I_col].values)
    rel_rmse = np.sqrt(np.mean((d[lambda_col].values - fitted) ** 2)) / d[lambda_col].mean()
    print(f"{label}: built on {len(d)} points [{spline.method}], "
          f"training rel. RMSE={rel_rmse:.3e}, "
          f"T {spline.t_range[0]:.1f}-{spline.t_range[1]:.1f} K, "
          f"I {spline.I_range[0]:.4f}-{spline.I_range[1]:.4f} mol/kg")
    return spline, spline.t_range, spline.I_range, d

def _residual_outlier_refit(spline, t_range, I_range, dfit, label):
    """Drop points whose relative residual against the provisional fit
    exceeds OUTLIER_REL_RESID_MAX, report each one, and refit once. Points
    on the (T, I) boundary of the data are flagged in the report, since
    excluding an edge point changes the hull. The lambda_0 anchor rows are
    exact by definition and are never excluded; if an anchor exceeds the
    threshold the low-I fit deserves a look, not the anchor."""
    fitted = np.atleast_1d(spline.ev(dfit['temp_K'].values, dfit['I'].values))
    rel = (dfit['Lambda'].values - fitted) / dfit['Lambda'].values
    bad = np.abs(rel) > OUTLIER_REL_RESID_MAX
    is_anchor = dfit['Source'].values == ANCHOR_SOURCE
    n_anchor_flagged = int((bad & is_anchor).sum())
    if n_anchor_flagged:
        print(f"  {label}: note - {n_anchor_flagged} lambda_0 anchor row(s) "
              f"exceed the residual threshold but are exempt from exclusion; "
              f"inspect the low-I fit if this persists.")
    bad &= ~is_anchor
    if not bad.any():
        print(f"  {label}: residual outlier filter (|rel resid| > "
              f"{OUTLIER_REL_RESID_MAX:.0%}): no exclusions.")
        return spline, t_range, I_range, dfit
    t_lo, t_hi = dfit['temp_K'].min(), dfit['temp_K'].max()
    I_lo, I_hi = dfit['I'].min(), dfit['I'].max()
    print(f"  {label}: residual outlier filter (|rel resid| > "
          f"{OUTLIER_REL_RESID_MAX:.0%}) excludes {int(bad.sum())} point(s):")
    for i in np.flatnonzero(bad):
        on_edge = (np.isclose(dfit['temp_K'].iloc[i], t_lo) or
                   np.isclose(dfit['temp_K'].iloc[i], t_hi) or
                   np.isclose(dfit['I'].iloc[i], I_lo) or
                   np.isclose(dfit['I'].iloc[i], I_hi))
        print(f"    T={dfit['temp_K'].iloc[i]:.1f} K, I={dfit['I'].iloc[i]:.4f}, "
              f"Source={dfit['Source'].iloc[i]}, rel resid={rel[i]:+.1%}"
              + ("  [boundary point - inspect before trusting exclusion]"
                 if on_edge else ""))
    dfit2 = dfit[~bad].copy()
    spline2, tr2, ir2, dfit2 = fit_lambda_spline(
        dfit2, label + ' [refit after residual filter]')
    return spline2, tr2, ir2, dfit2

def subtract_ion_molar(source_df, salt_name, known_ion, model,
                       new_ion_pretty_label=None, known_ion_extrap_mode=None):
    """One deconvolution step: derive a new ion's lambda from a two-ion salt
    by subtracting the known ion's contribution,
        lambda_new = (kappa - kappa_pairs - m_free_known * lambda_known) / m_free_new,
    then fit the new ion's surface (with lambda_0 anchors) and run the
    residual outlier filter.

    Where the salt's data reach below the known ion's training floor, the
    known ion's lambda can be recovered with the cold-side tangent
    extrapolation (known_ion_extrap_mode='linear'); those rows are tagged
    From_Extrapolated_Known=True so their influence stays traceable.

    Two guards drop unreliable rows before fitting: rows where the known
    ion carries more than SUBTRACTION_FRACTION_MAX of kappa (the residual
    is then noise-dominated), and rows where the new ion's free molality is
    below MIN_FREE_MOLALITY_MOLKG (the division blows up measurement error).
    Non-positive derived lambdas are dropped with a report of whether they
    cluster in one (T, I) region (a coverage gap) or scatter (noise)."""
    stoich = model.stoich_for(salt_name)
    if known_ion not in stoich:
        raise ValueError(f"{salt_name} stoichiometry {stoich} has no ion '{known_ion}'.")
    unknown_ions = [ion for ion in stoich if ion != known_ion]
    if len(unknown_ions) != 1:
        raise ValueError(f"subtract_ion_molar needs a two-ion salt; {salt_name}: {stoich}.")
    new_ion = unknown_ions[0]
    new_ion_label = new_ion_pretty_label or f"{new_ion} (from {salt_name})"
    ion_spline = model.ion(known_ion)
    src = source_df
    I_vals = src['I'].values
    t_vals = src['temp_K'].values
    m_salt = src['Molality'].values
    src_vals = src['Source'].values
    m_free_known = src[ION_FREE_COL[known_ion]].values
    m_free_new_all = src[ION_FREE_COL[new_ion]].values
    lambda_known = ion_spline.ev_or_nan(t_vals, I_vals)
    from_extrap = np.zeros(len(src), dtype=bool)
    if known_ion_extrap_mode is not None:
        need_extrap = np.isnan(lambda_known)
        if need_extrap.any():
            extrap_vals = ion_spline.ev_extrap(t_vals[need_extrap], I_vals[need_extrap],
                                               mode=known_ion_extrap_mode)
            lambda_known = lambda_known.copy()
            lambda_known[need_extrap] = extrap_vals
            fin = np.isfinite(extrap_vals)
            idx_need = np.flatnonzero(need_extrap)
            from_extrap[idx_need[fin]] = True
            n_extrap_used = int(fin.sum())
            extrap_range = (f"{extrap_vals[fin].min():.3g} to {extrap_vals[fin].max():.3g}"
                            if n_extrap_used else "n/a")
            print(f"  {salt_name} -> {new_ion_label}: {n_extrap_used}/{int(need_extrap.sum())} "
                  f"below-hull points recovered via {known_ion}.ev_extrap"
                  f"('{known_ion_extrap_mode}'), lambda range: {extrap_range}. "
                  f"Rows tagged From_Extrapolated_Known=True.")
    in_hull = np.isfinite(lambda_known)
    n_out = int((~in_hull).sum())
    if n_out > 0:
        print(f"Note: {salt_name} -> {new_ion_label}: {n_out}/{len(src)} points outside "
              f"the {known_ion} spline's coverage at solution I. Excluded.")
    T = t_vals[in_hull]
    I = I_vals[in_hull]
    M = m_salt[in_hull]
    S = src_vals[in_hull]
    mk = m_free_known[in_hull]
    mn = m_free_new_all[in_hull]
    lk = lambda_known[in_hull]
    fx = from_extrap[in_hull]
    kappa_salt = src['Conductivity'].values[in_hull]
    kappa_pairs = np.zeros_like(kappa_salt)
    if PAIR_CONDUCTION and salt_name in SALT_PAIR_TERMS:
        cols = [c for c in SALT_PAIR_TERMS[salt_name] if c in src.columns]
        if cols:
            kappa_pairs = pair_conduction_mc12(src[in_hull], T, I, cols)
            frac_pairs = kappa_pairs / kappa_salt
            print(f"  {salt_name}: subtracting {', '.join(cols)} conduction "
                  f"(McCleskey 2012 pair expressions; up to "
                  f"{100 * frac_pairs.max():.1f}% of kappa).")
    f = (mk * lk) / kappa_salt
    print(f"  {salt_name}: subtraction fraction f distribution: min={f.min():.3f}, "
          f"median={np.median(f):.3f}, max={f.max():.3f} (n={len(f)}).")
    excl_f = f > SUBTRACTION_FRACTION_MAX
    excl_m = mn < MIN_FREE_MOLALITY_MOLKG
    excl_any = excl_f | excl_m
    if excl_any.any():
        print(f"  {salt_name} -> {new_ion_label}: excluding {int(excl_any.sum())} "
              f"row(s) by subtraction guards:")
        for i in np.flatnonzero(excl_any):
            reasons = []
            if excl_f[i]:
                reasons.append(f"f={f[i]:.3f} > {SUBTRACTION_FRACTION_MAX}")
            if excl_m[i]:
                reasons.append(f"m_free_new={mn[i]:.3g} < {MIN_FREE_MOLALITY_MOLKG:g}")
            print(f"    (T={T[i]:.1f} K, I={I[i]:.4f}, {S[i]}): " + '; '.join(reasons))
    keep = ~excl_any
    lambda_new = (kappa_salt - kappa_pairs - mk * lk) / np.where(mn > 0, mn, np.nan)
    kept_idx = np.flatnonzero(keep)
    lam_k = lambda_new[kept_idx]
    posmask = lam_k > 0
    if (~posmask).any():
        drop_idx = kept_idx[~posmask]
        print(f"Warning: {len(drop_idx)} {new_ion_label} derived point(s) "
              f"non-positive - dropped:")
        for i in drop_idx:
            print(f"    T={T[i]:.1f} K, I={I[i]:.4f}, Source={S[i]}, "
                  f"f={f[i]:.3f}, m_free_new={mn[i]:.3g}, lambda={lambda_new[i]:.3g}")
        T_d, I_d = T[drop_idx], I[drop_idx]
        t_span = max(T.max() - T.min(), 1e-9)
        i_span = max(I.max() - I.min(), 1e-9)
        t_frac = (T_d.max() - T_d.min()) / t_span
        i_frac = (I_d.max() - I_d.min()) / i_span
        if len(drop_idx) >= 2 and t_frac < 0.25 and i_frac < 0.25:
            print(f"    -> dropped points cluster in T "
                  f"[{T_d.min():.1f}, {T_d.max():.1f}] K, I "
                  f"[{I_d.min():.4f}, {I_d.max():.4f}] "
                  f"({t_frac:.0%} of T span, {i_frac:.0%} of I span): likely a "
                  f"coverage gap in that (T, I) region, not noise.")
        else:
            print(f"    -> dropped points are scattered across (T, I) "
                  f"({t_frac:.0%} of T span, {i_frac:.0%} of I span): "
                  f"consistent with noise.")
    final_idx = kept_idx[posmask]
    ion_df = pd.DataFrame({'Source': S[final_idx], 'temp_K': T[final_idx],
                           'I': I[final_idx], 'Molality': M[final_idx],
                           'Lambda': lambda_new[final_idx],
                           'From_Extrapolated_Known': fx[final_idx]})
    spline, t_range, I_range, dfit = fit_lambda_spline(ion_df, new_ion_label,
                                                       anchor_ion=new_ion)
    spline, t_range, I_range, dfit = _residual_outlier_refit(
        spline, t_range, I_range, dfit, new_ion_label)
    n_tag = int(dfit['From_Extrapolated_Known'].sum())
    print(f"  {new_ion_label}: {n_tag}/{len(dfit)} fitted points carry "
          f"From_Extrapolated_Known=True (known-ion lambda extrapolated).")
    model.add_ion(new_ion, spline)
    return spline, t_range, I_range, dfit

# ==========================================
# SEQUENTIAL DECONVOLUTION CHAIN
# ==========================================
# KCl is the reference salt: its conductivity is split into K+ and Cl-
# contributions with the KCl transport number. Every other ion is then
# derived by subtracting an already-fitted ion from a two-ion salt:
# Cl- from NaCl, MgCl2, CaCl2, NH4Cl gives Na+, Mg2+, Ca2+, NH4+;
# Na+ from Na2SO4 gives SO42-.
df_kcl = salt_dfs['KCl'].copy()
df_kcl['Lambda_Salt'] = df_kcl['Conductivity'] / df_kcl['m_free_K']
t_plus = calculate_t_kcl(df_kcl['Temperature'].values, df_kcl['Molality'].values)
df_kcl['Lambda_K'] = t_plus * df_kcl['Lambda_Salt']
df_kcl['Lambda_Cl'] = (df_kcl['Conductivity'] / df_kcl['m_free_Cl']) - \
    (df_kcl['Lambda_K'] * df_kcl['m_free_K'] / df_kcl['m_free_Cl'])
df_k_ion = pd.DataFrame({'Source': df_kcl['Source'], 'temp_K': df_kcl['temp_K'],
                         'I': df_kcl['I'], 'Molality': df_kcl['Molality'],
                         'Lambda': df_kcl['Lambda_K'],
                         'From_Extrapolated_Known': False})
df_cl_ion = pd.DataFrame({'Source': df_kcl['Source'], 'temp_K': df_kcl['temp_K'],
                          'I': df_kcl['I'], 'Molality': df_kcl['Molality'],
                          'Lambda': df_kcl['Lambda_Cl'],
                          'From_Extrapolated_Known': False})
print("\n" + "=" * 70)
print("Sequential deconvolution chain")
print("=" * 70)
model = IonConductivityModel(speciation=spec_lookup)
spline_k, k_t_range, k_I_range, df_k_ion = fit_lambda_spline(
    df_k_ion, 'K+ (from KCl)', anchor_ion='K')
spline_cl, cl_t_range, cl_I_range, df_cl_ion = fit_lambda_spline(
    df_cl_ion, 'Cl- (from KCl)', anchor_ion='Cl')
model.add_ion('K', spline_k)
model.add_ion('Cl', spline_cl)

# Sub-zero KCl conductivity data would remove the need for the cold-side
# tangent extrapolation of the K+/Cl- surfaces below their training floor,
# and with it the extrapolated segment of every ion derived from them.
spline_na, na_t_range, na_I_range, df_na_ion = subtract_ion_molar(
    salt_dfs['NaCl'].copy(), 'NaCl', known_ion='Cl', model=model,
    new_ion_pretty_label='Na+ (unified)',
    known_ion_extrap_mode='linear')
_na_meas = df_na_ion[df_na_ion['Source'] != ANCHOR_SOURCE]
_fit_check = spline_na.ev(_na_meas['temp_K'].values, _na_meas['I'].values)
_rel = np.sqrt(np.mean((_na_meas['Lambda'].values - _fit_check) ** 2)) / _na_meas['Lambda'].mean()
if _rel > 0.20:
    raise RuntimeError(f'Na+ sanity gate: training rel. RMSE {_rel:.2%} > 20%.')

spline_mg, mg_t_range, mg_I_range, df_mg_ion = subtract_ion_molar(
    salt_dfs['MgCl2'].copy(), 'MgCl2', known_ion='Cl', model=model,
    new_ion_pretty_label='Mg2+ (from MgCl2)',
    known_ion_extrap_mode='linear')
spline_so4, so4_t_range, so4_I_range, df_so4_ion = subtract_ion_molar(
    salt_dfs['Na2SO4'].copy(), 'Na2SO4', known_ion='Na', model=model,
    new_ion_pretty_label='SO4 2- (from Na2SO4)',
    known_ion_extrap_mode='linear')
spline_ca, ca_t_range, ca_I_range, df_ca_ion = subtract_ion_molar(
    salt_dfs['CaCl2'].copy(), 'CaCl2', known_ion='Cl', model=model,
    new_ion_pretty_label='Ca2+ (from CaCl2)',
    known_ion_extrap_mode='linear')
spline_nh4, nh4_t_range, nh4_I_range, df_nh4_ion = subtract_ion_molar(
    salt_dfs['NH4Cl'].copy(), 'NH4Cl', known_ion='Cl', model=model,
    new_ion_pretty_label='NH4+ (from NH4Cl)',
    known_ion_extrap_mode='linear')

SEQ_SPLINES = {'K': spline_k, 'Cl': spline_cl, 'Na': spline_na, 'Mg': spline_mg,
               'SO4': spline_so4, 'Ca': spline_ca, 'NH4': spline_nh4}
SEQ_ION_DFS = {'K': df_k_ion, 'Cl': df_cl_ion, 'Na': df_na_ion, 'Mg': df_mg_ion,
               'SO4': df_so4_ion, 'Ca': df_ca_ion, 'NH4': df_nh4_ion}

print("\nExtrapolated-known-ion usage per derived ion:")
for _ion, _dfi in SEQ_ION_DFS.items():
    _n = int(_dfi['From_Extrapolated_Known'].sum())
    print(f"  {_ion:4s}: {_n}/{len(_dfi)} fitted points tagged From_Extrapolated_Known.")

print("\nLambda_0 anchor usage per ion surface:")
for _ion, _dfi in SEQ_ION_DFS.items():
    _n = int((_dfi['Source'] == ANCHOR_SOURCE).sum())
    print(f"  {_ion:4s}: {_n}/{len(_dfi)} fitted points are I=0 lambda_0 anchors.")

# ==========================================
# SALT-CLOSURE DIAGNOSTIC
# ==========================================
def salt_closure_diagnostic(mdl, fit_salts):
    """Reconstruct kappa for every training salt from the fitted ion
    surfaces plus the pair terms, at the training conditions, and compare
    against the measurements. Prints per-salt and per-source relative RMSE,
    plots percent deviation vs T and vs molality, and raises if any salt's
    closure relative RMSE exceeds SALT_CLOSURE_RMSE_MAX."""
    print("\n" + "=" * 70)
    print("Salt-closure diagnostic (training salts)")
    print("=" * 70)
    n = len(fit_salts)
    ncols = 3
    nrows = int(np.ceil(n / ncols))
    figT, axesT = plt.subplots(nrows, ncols, figsize=(4.2 * ncols, 3.2 * nrows),
                               squeeze=False)
    figM, axesM = plt.subplots(nrows, ncols, figsize=(4.2 * ncols, 3.2 * nrows),
                               squeeze=False)
    failures = []
    for i, salt in enumerate(fit_salts):
        d = salt_dfs[salt]
        pred = np.atleast_1d(mdl.predict_from_speciation(
            salt, d['temp_K'].values, d['Molality'].values, extrap_mode='linear'))
        meas = d['Conductivity'].values
        ok = np.isfinite(pred) & np.isfinite(meas) & (meas != 0)
        dev = (pred[ok] - meas[ok]) / meas[ok]
        rel_rmse = float(np.sqrt(np.mean(dev ** 2))) if ok.any() else np.nan
        print(f"  {salt:8s}: closure rel. RMSE = {rel_rmse:.3%} "
              f"on {int(ok.sum())}/{len(d)} rows")
        for src in sorted(d['Source'].unique()):
            m_src = ok & (d['Source'].values == src)
            if m_src.any():
                dev_s = (pred[m_src] - meas[m_src]) / meas[m_src]
                print(f"      {src:14s}: rel. RMSE = "
                      f"{np.sqrt(np.mean(dev_s ** 2)):.3%} (n={int(m_src.sum())})")
        axT = axesT[i // ncols][i % ncols]
        axM = axesM[i // ncols][i % ncols]
        for src in sorted(d['Source'].unique()):
            m_src = ok & (d['Source'].values == src)
            if m_src.any():
                dev_s = 100.0 * (pred[m_src] - meas[m_src]) / meas[m_src]
                axT.scatter(d['Temperature'].values[m_src], dev_s, s=10, label=src)
                axM.scatter(d['Molality'].values[m_src], dev_s, s=10, label=src)
        for ax, xl in [(axT, 'T ($^\\circ$C)'), (axM, 'molality (mol kg$^{-1}$)')]:
            ax.axhline(0, color='k', lw=0.8)
            ax.set_title(f"{salt} (rel. RMSE {rel_rmse:.1%})")
            ax.set_xlabel(xl)
            ax.set_ylabel('deviation (%)')
            ax.legend(fontsize=7)
        if np.isfinite(rel_rmse) and rel_rmse > SALT_CLOSURE_RMSE_MAX:
            failures.append((salt, rel_rmse))
    for j in range(n, nrows * ncols):
        axesT[j // ncols][j % ncols].set_visible(False)
        axesM[j // ncols][j % ncols].set_visible(False)
    figT.suptitle('Salt closure: percent deviation vs temperature')
    figM.suptitle('Salt closure: percent deviation vs molality')
    figT.tight_layout()
    figM.tight_layout()
    save_fig(figT, 'salt_closure_dev_vs_T')
    save_fig(figM, 'salt_closure_dev_vs_molality')
    plt.show()
    plt.close(figT)
    plt.close(figM)
    if failures:
        raise RuntimeError(
            'Salt-closure gate: training-salt closure relative RMSE exceeds '
            f'{SALT_CLOSURE_RMSE_MAX:.0%} for: '
            + ', '.join(f'{s} ({r:.1%})' for s, r in failures))
    print(f"  Salt-closure gate passed (all salts <= {SALT_CLOSURE_RMSE_MAX:.0%}).")

salt_closure_diagnostic(model, FIT_SALTS)

