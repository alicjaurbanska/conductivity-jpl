            raise ValueError(f'{tag} has no rows at reference pressure.')
    d = d[~d['Molality_molkg'].isna()].copy()
    if d.empty:
        raise ValueError(f'{tag} has no usable rows left.')
    n_unspec = d['I_eff'].isna().sum()
    if n_unspec > 0:
        print(f'NOTE: {tag}: {n_unspec}/{len(d)} rows missing from {SPECIATION_FILE}. Dropped.')
        d = d[d['I_eff'].notna()].copy()
    if d.empty:
        raise ValueError(f'{tag} has no speciated rows. Run speciate_library.py.')
    d = d.rename(columns={'Molality_molkg': 'Molality', 'Temperature_C': 'Temperature',
                          'Conductivity_mScm': 'Conductivity'})
    d['temp_K'] = d['Temperature'] + 273.15
    d['I'] = d['I_eff']
    return d

def _iapws_filter(d, tag):
    ok_T, n_T, T_rng = VISC.coverage_check(d['temp_K'].values)
    if n_T > 0:
        print(f"  IAPWS floor [{tag}]: excluding {n_T}/{len(d)} rows below "
              f"{WaterViscosity.T_MIN:.2f} K (excluded: "
              f"{T_rng[0]-273.15:.1f} to {T_rng[1]-273.15:.1f} C).")
        d = d[ok_T].copy()
    hot = d['temp_K'].values > WaterViscosity.T_MAX
    if hot.any():
        print(f"  IAPWS ceiling [{tag}]: excluding {int(hot.sum())}/{len(d)} rows above "
              f"{WaterViscosity.T_MAX:.2f} K (max in data: {d['Temperature'].max():.1f} C).")
        d = d[~hot].copy()
    over = d['Pressure_MPa'].values > IAPWS_P_CEILING_MPA
    if over.any():
        print(f"  IAPWS P ceiling [{tag}]: excluding {int(over.sum())}/{len(d)} rows above "
              f"{IAPWS_P_CEILING_MPA:.0f} MPa.")
        d = d[~over].copy()
    if d.empty:
        raise ValueError(f'{tag}: no rows left inside the IAPWS validity window.')
    return d

