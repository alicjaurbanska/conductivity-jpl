    (src, salt) for src, salts in PROMOTED_SALTS_BY_SOURCE.items() for salt in salts
    if salt in VALIDATION_SALTS_BY_SOURCE.get(src, [])
]
if _promoted_also_validated:
    raise ValueError(f'Contamination guard: {_promoted_also_validated} in both '
                     f'PROMOTED_SALTS_BY_SOURCE and VALIDATION_SALTS_BY_SOURCE.')

def _training_sources_for_salt(salt):
    extra = {src for src, salts in PROMOTED_SALTS_BY_SOURCE.items() if salt in salts}
    return set(TRAINING_SOURCES) | extra

FIT_SALTS = ['KCl', 'NaCl', 'MgCl2', 'Na2SO4', 'CaCl2', 'NH4Cl']
