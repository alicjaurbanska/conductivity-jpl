# 0.5 SPECIATION LOOKUP
# ==========================================
ION_FREE_COL = {'K': 'm_free_K', 'Cl': 'm_free_Cl', 'Na': 'm_free_Na',
                'Mg': 'm_free_Mg', 'SO4': 'm_free_SO4',
                'NH4': 'm_free_NH4', 'Ca': 'm_free_Ca'}
PAIR_COLS = ['m_pair_KSO4', 'm_pair_NaSO4', 'm_pair_MgSO4']
MERGE_DECIMALS = 6

class SpeciationLookup:
    def __init__(self, spec_df):
        self.interp2d = {}
        self.interp3d = {}
        self.P_levels = {}
        self._warned = set()
        all_cols = list(ION_FREE_COL.values()) + PAIR_COLS + ['I_eff']
        for salt, d in spec_df.groupby('Salt'):
            P_lv = np.sort(d['Pressure_MPa'].round(MERGE_DECIMALS).unique())
            self.P_levels[salt] = P_lv
            cols_present = [c for c in all_cols if c in d.columns]
            d0 = d[d['Pressure_MPa'].round(MERGE_DECIMALS) == P_lv[0]]
            pts0 = np.column_stack([d0['Temperature_C'].values + 273.15,
                                    d0['Molality_molkg'].values])
            self.interp2d[salt] = {c: LinearNDInterpolator(pts0, d0[c].values)
                                   for c in cols_present}
            if len(P_lv) > 1 and not AMBIENT_ONLY:
                pts3 = np.column_stack([d['Temperature_C'].values + 273.15,
                                        d['Molality_molkg'].values,
                                        d['Pressure_MPa'].values])
                try:
                    self.interp3d[salt] = {c: LinearNDInterpolator(pts3, d[c].values,
                                                                   rescale=True)
                                           for c in cols_present}
                    print(f"SpeciationLookup: {salt} at {len(P_lv)} pressures "
                          f"({P_lv.min():.1f}-{P_lv.max():.1f} MPa) -> 3D lookup enabled.")
                except Exception as e:
                    print(f"SpeciationLookup WARNING: 3D build failed for {salt} ({e}); "
                          f"using the P={P_lv[0]} MPa plane for ALL queries.")
    def get(self, salt, T_K, molality, col, P_MPa=None):
        T_K = np.atleast_1d(np.asarray(T_K, dtype=float))
        molality = np.atleast_1d(np.asarray(molality, dtype=float))
        f2 = self.interp2d[salt].get(col)
        if f2 is None:
            return np.full(T_K.shape, np.nan)
        P_lv = self.P_levels[salt]
        P = np.broadcast_to(np.atleast_1d(np.asarray(
            REFERENCE_PRESSURE_MPA if P_MPa is None else P_MPa, dtype=float)), T_K.shape)
        if salt not in self.interp3d:
            if len(P_lv) == 1 and np.any(np.abs(P - P_lv[0]) > 1e-6) and salt not in self._warned:
                self._warned.add(salt)
                print(f"  SpeciationLookup NOTE: {salt} chemistry tabulated only at "
                      f"{P_lv[0]} MPa; using it for other pressures.")
            return f2(T_K, molality)
        on_plane = np.abs(P - P_lv[0]) <= 1e-6
        if np.all(on_plane):
            return f2(T_K, molality)
        f3 = self.interp3d[salt][col]
        out = f3(T_K, molality, np.clip(P, P_lv[0], P_lv[-1]))
        if np.any(on_plane):
            out = np.where(on_plane, f2(T_K, molality), out)
        return out

